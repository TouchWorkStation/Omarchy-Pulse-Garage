def make_wrapped(year: str, conf: dict, keep_parts: bool = False) -> Path | None:
    """Pulse Wrapped: your year as a short video, the days of your city and the numbers of your year (ffmpeg)."""
    if not shutil.which("ffmpeg"):
        return None
    out_dir = Path(str(conf.get("dir") or (HOME / "Videos" / "omarchy-pulse"))).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)
    days = sorted(out_dir.glob(f"pulse-{year}-*.mp4"))
    pick = [days[round(i * (len(days) - 1) / 23)] for i in range(min(24, len(days)))] if days else []
    work = STATE_DIR / "wrapped"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    font = ""
    if shutil.which("fc-match"):
        font = subprocess.run(["fc-match", "-f", "%{file}", "monospace:bold"], capture_output=True, text=True).stdout.strip()
    enc = ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", "-r", "30"]
    parts = []

    def card(i, text):
        tf = work / f"card{i}.txt"
        tf.write_text(text.replace("\\n", "\n"))
        out = work / f"part{len(parts):03d}.mp4"
        dt_ = (f"drawtext=textfile='{tf}':fontcolor=white:fontsize=54:line_spacing=18:x=(w-text_w)/2:y=(h-text_h)/2"
               + (f":fontfile='{font}'" if font else ""))
        r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "lavfi", "-i", "color=c=0x0b0f1a:s=1280x720:d=2.6",
                            "-vf", dt_ + ",fade=t=in:d=0.4,fade=t=out:st=2.2:d=0.4", *enc, str(out)], capture_output=True, timeout=120)
        if r.returncode == 0:
            parts.append(out)

    g = growth_from_file()
    cards = wrapped_cards(year, year_stats(year), g)
    card(0, cards[0])
    for k, f in enumerate(pick):   # a moment of each day: the middle of its timelapse
        out = work / f"part{len(parts):03d}.mp4"
        mid = 8.0
        if shutil.which("ffprobe"):
            pr = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(f)],
                                capture_output=True, text=True, timeout=30)
            try:
                mid = max(0.0, float(pr.stdout.strip()) / 2 - 0.7)
            except ValueError:
                pass
        r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{mid:.2f}", "-i", str(f), "-t", "1.4",
                            "-vf", "scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2", "-an",
                            *enc, str(out)], capture_output=True, timeout=120)
        if r.returncode == 0 and out.exists() and out.stat().st_size > 0:
            parts.append(out)
    for i, c in enumerate(cards[1:], 1):
        card(i, c)
    if len(parts) < 2:
        return None
    lst = work / "list.txt"
    lst.write_text("".join(f"file '{x}'\n" for x in parts))
    final = out_dir / f"pulse-wrapped-{year}.mp4"
    r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy",
                        "-movflags", "+faststart", str(final)], capture_output=True, timeout=300)
    if not keep_parts:
        shutil.rmtree(work, ignore_errors=True)
    return final if r.returncode == 0 else None


