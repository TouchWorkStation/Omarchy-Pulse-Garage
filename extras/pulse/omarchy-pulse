def meteor_shower(t: float) -> dict | None:
    """The meteor shower of these nights, if any: its name and how strong it is now (0..1 of its peak)."""
    import datetime as dt
    d = dt.datetime.fromtimestamp(t)
    for name, mo, day, span, zhr, ra, dec in SHOWERS:
        for y in (d.year - 1, d.year, d.year + 1):
            peak = dt.datetime(y, mo, day, 3)
            off = abs((d - peak).total_seconds()) / 86400
            if off <= span + 0.5:
                return {"name": name, "zhr": zhr, "ra": ra, "dec": dec, "strength": round(max(0.15, 1 - off / (span + 1)), 2)}
    return None


def night_sky(lat: float, lon: float, t: float | None = None) -> dict:
    """Everything in your sky right now: the Sun's height, the Moon (where, how lit), the planets, the stars and the
    lines between them, and the meteor shower of these nights with its radiant."""
    t = t if t is not None else time.time()
    jd = julian(t)
    s_az, s_el = altaz(*sun_radec(jd), lat, lon, jd)
    m_ra, m_dec = ecl_to_eq(*moon_ecl(jd))
    m_az, m_el = altaz(m_ra, m_dec, lat, lon, jd)
    import math
    m_el -= 0.95 * math.cos(math.radians(m_el))   # parallax: from the surface, the Moon is a little lower
    stars = []
    for name, ra, dec, mag in STARS:
        az, el = altaz(ra, dec, lat, lon, jd)
        if el > -2:
            stars.append({"n": name, "az": round(az, 2), "el": round(el, 2), "m": mag})
    seen = {s["n"]: i for i, s in enumerate(stars)}
    lines, names = [], []
    for cname, pairs in CONSTELLATIONS.items():
        members = [seen[n] for n in {n for p in pairs for n in p} | ({"Vega"} if cname == "LYRA" else set()) if n in seen]
        for a, b in pairs:
            if a in seen and b in seen:
                lines.append([seen[a], seen[b]])
        if members:
            names.append({"n": cname, "i": members})
    planets = []
    for p in ("venus", "mars", "jupiter", "saturn"):
        az, el = altaz(*planet_radec(p, jd), lat, lon, jd)
        if el > -2:
            planets.append({"n": p, "az": round(az, 2), "el": round(el, 2), "m": PLANETS[p][2]})
    sh = meteor_shower(t)
    if sh:
        sh["az"], sh["el"] = (round(v, 1) for v in altaz(sh.pop("ra"), sh.pop("dec"), lat, lon, jd))
    return {"t": t, "sun": {"az": round(s_az, 2), "el": round(s_el, 2)},
            "moon": {"az": round(m_az, 2), "el": round(m_el, 2), **moon_phase(jd)},
            "planets": planets, "stars": stars, "lines": lines, "names": names, "shower": sh}


# ---------------------------------------------------------------- Starlink trains (1.4): the satellites of the last
# launches, from their real orbits (CelesTrak). SGP4 when python-sgp4 is installed, else a J2 orbit: close enough for
# a pass in the first days after a launch, when the satellites still fly in a line, like a train of lights.

def omm_epoch(s: str) -> float:
    import datetime as dt
    return dt.datetime.fromisoformat(str(s).replace("Z", "")).replace(tzinfo=dt.timezone.utc).timestamp()


def sat_eci(o: dict, t: float) -> tuple:
    """Where a satellite is (km, Earth-centred inertial) at time t, from its CelesTrak OMM elements."""
    import math
    try:
        from sgp4 import omm as _omm
        from sgp4.api import Satrec
        sat = o.get("_sgp4")
        if sat is None:
            sat = Satrec()
            _omm.initialize(sat, o)
            o["_sgp4"] = sat
        jd = julian(t)
        e, r, _v = sat.sgp4(math.floor(jd - 0.5) + 0.5, jd - (math.floor(jd - 0.5) + 0.5))
        if e == 0:
            return tuple(r)
    except ImportError:
        pass
    mu, Re, J2 = 398600.4418, 6378.137, 1.08263e-3
    nk = float(o["MEAN_MOTION"]) * 2 * math.pi / 86400           # rad/s, Kozai mean motion (as in a TLE)
    e, i = float(o["ECCENTRICITY"]), math.radians(float(o["INCLINATION"]))
    a1 = (mu / (nk * nk)) ** (1 / 3)                               # back to Brouwer's mean motion, as SGP4 does
    k2 = 0.5 * J2 * Re * Re
    d1 = 1.5 * k2 * (3 * math.cos(i) ** 2 - 1) / (1 - e * e) ** 1.5
    dl = d1 / (a1 * a1)
    a0 = a1 * (1 - dl / 3 - dl * dl - 134 / 81 * dl ** 3)
    n0 = nk / (1 + d1 / (a0 * a0))
    a = (mu / (n0 * n0)) ** (1 / 3)
    dt_s = t - omm_epoch(o["EPOCH"])
    p = a * (1 - e * e)
    k = 1.5 * J2 * (Re / p) ** 2 * n0
    raan = math.radians(float(o["RA_OF_ASC_NODE"])) - k * math.cos(i) * dt_s
    argp = math.radians(float(o["ARG_OF_PERICENTER"])) + k * (2 - 2.5 * math.sin(i) ** 2) * dt_s
    M = (math.radians(float(o["MEAN_ANOMALY"])) + (n0 + k * math.sqrt(1 - e * e) * (1 - 1.5 * math.sin(i) ** 2)) * dt_s
         + 2 * math.pi * float(o.get("MEAN_MOTION_DOT") or 0) * (dt_s / 86400) ** 2)
    E = M
    for _ in range(8):
        E = E - (E - e * math.sin(E) - M) / (1 - e * math.cos(E))
    nu = 2 * math.atan2(math.sqrt(1 + e) * math.sin(E / 2), math.sqrt(1 - e) * math.cos(E / 2))
    r = a * (1 - e * math.cos(E))
    u = argp + nu
    cO, sO, cu, su, ci, si = math.cos(raan), math.sin(raan), math.cos(u), math.sin(u), math.cos(i), math.sin(i)
    return (r * (cO * cu - sO * su * ci), r * (sO * cu + cO * su * ci), r * su * si)


def sat_look(o: dict, lat: float, lon: float, t: float) -> tuple:
    """Azimuth, elevation and whether the Sun lights it (as seen from the ground, the satellite shines only when lit)."""
    import math
    x, y, z = sat_eci(o, t)
    g = math.radians(gmst_deg(julian(t)))
    xe, ye = x * math.cos(g) + y * math.sin(g), -x * math.sin(g) + y * math.cos(g)   # inertial -> Earth-fixed
    r = math.sqrt(x * x + y * y + z * z)
    slat, slon = math.degrees(math.asin(z / r)), math.degrees(math.atan2(ye, xe))
    az, el = look_angles(lat, lon, slat, slon, r - 6371.0)
    lam = math.radians(sun_ecl(julian(t)))
    eps = math.radians(23.439)
    s = (math.cos(lam), math.cos(eps) * math.sin(lam), math.sin(eps) * math.sin(lam))   # the Sun's direction (inertial)
    along = x * s[0] + y * s[1] + z * s[2]
    perp = math.sqrt(max(0.0, r * r - along * along))
    lit = along > 0 or perp > 6371.0   # outside the Earth's shadow cylinder
    return az, el, lit


def starlink_groups(rows: list) -> dict:
    """The Starlink satellites of each launch (international designator 2026-123), the ones that still fly together."""
    groups: dict = {}
    for o in rows or []:
        if not isinstance(o, dict) or not str(o.get("OBJECT_NAME", "")).upper().startswith("STARLINK"):
            continue
        gid = str(o.get("OBJECT_ID") or "")[:8]
        if gid:
            groups.setdefault(gid, []).append(o)
    return {g: sorted(v, key=lambda o: str(o.get("OBJECT_ID"))) for g, v in groups.items() if len(v) >= 5}


def starlink_passes(groups: dict, lat: float, lon: float, t0: float, hours: float = 24, step: float = 30) -> list:
    """The visible passes of each train in the next hours: lit by the Sun, high enough, while it is dark where you are."""
    out = []
    for gid, sats in groups.items():
        lead = sats[len(sats) // 2]   # the middle of the train
        best, start = None, None
        t = t0
        while t < t0 + hours * 3600:
            az, el, lit = sat_look(lead, lat, lon, t)
            sun_el = altaz(*sun_radec(julian(t)), lat, lon, julian(t))[1]
            ok = el > 10 and lit and sun_el < -6
            if ok:
                start = start or t
                if not best or el > best[1]:
                    best = (t, el, az)
            elif start:
                out.append({"group": gid, "start": start, "end": t, "max_el": round(best[1]), "az": round(best[2]), "n": len(sats)})
                start, best = None, None
            t += step
    return sorted(out, key=lambda p: p["start"])


def look_angles(lat: float, lon: float, slat: float, slon: float, alt_km: float) -> tuple:
    """Azimuth (0 = north, 90 = east) and elevation in degrees of a satellite seen from (lat, lon)."""
    import math
    R = 6371.0
    def ecef(la, lo, r):
        la, lo = math.radians(la), math.radians(lo)
        return (r * math.cos(la) * math.cos(lo), r * math.cos(la) * math.sin(lo), r * math.sin(la))
    o, sat = ecef(lat, lon, R), ecef(slat, slon, R + alt_km)
    d = [sat[i] - o[i] for i in range(3)]
    la, lo = math.radians(lat), math.radians(lon)
    e = (-math.sin(lo), math.cos(lo), 0.0)
    n = (-math.sin(la) * math.cos(lo), -math.sin(la) * math.sin(lo), math.cos(la))
    u = (math.cos(la) * math.cos(lo), math.cos(la) * math.sin(lo), math.sin(la))
    dot = lambda a, b: sum(a[i] * b[i] for i in range(3))
    dist = math.sqrt(dot(d, d))
    el = math.degrees(math.asin(max(-1.0, min(1.0, dot(d, u) / dist))))
    az = (math.degrees(math.atan2(dot(d, e), dot(d, n))) + 360) % 360
    return az, el


def latest_kp(rows) -> float | None:
    """NOAA's planetary K index: a list of objects or a header row and lists, oldest first."""
    if not isinstance(rows, list) or not rows:
        return None
    last = rows[-1]
    if isinstance(last, dict):
        v = next((last[k] for k in ("Kp", "kp", "kp_index", "estimated_kp") if k in last), None)
    elif isinstance(last, list) and isinstance(rows[0], list) and "Kp" in rows[0]:
        v = last[rows[0].index("Kp")]
    else:
        v = None
    try:
        return round(float(v), 2)
    except (TypeError, ValueError):
        return None


def growth_days(ts: list) -> set:
