            time.sleep(max(5, int(c.get("every", 10) or 10)))

    # -- the air you breathe: air quality (European AQI) and pollen, from Open-Meteo
    def loop_air(self) -> None:
        warned, said = 0.0, ""
        while True:
            c = self.conf("air", default={}) or {}
