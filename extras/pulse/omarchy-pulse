def voice_lang(v: dict) -> str:
    lang = str((v or {}).get("language") or "en").lower()[:2]
    return lang if lang in LANGS else "en"


def phrase(key: str, lang: str = "en", **kw) -> str:
    p = PHRASES[key]
    return (p.get(lang) or p["en"]).format(**kw).strip()


def spoken_duration(mins: float, lang: str = "en") -> str:
    """1 hour 5 minutes, 2 ore, 45 minutos..."""
    h, m = divmod(int(round(mins)), 60)
    w = {"en": (("hour", "hours"), ("minute", "minutes")), "it": (("ora", "ore"), ("minuto", "minuti")),
         "es": (("hora", "horas"), ("minuto", "minutos")), "fr": (("heure", "heures"), ("minute", "minutes")),
         "de": (("Stunde", "Stunden"), ("Minute", "Minuten"))}.get(lang) or (("hour", "hours"), ("minute", "minutes"))
    parts = ([f"{h} {w[0][h != 1]}"] if h else []) + ([f"{m} {w[1][m != 1]}"] if m or not h else [])
    return " ".join(parts)


def voice_model(v: dict) -> str | None:
    m = str(v.get("model") or "")
    if m:
        p = Path(m).expanduser()
        return str(p) if p.is_file() else None
    d = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "piper"
    found = sorted(d.glob("*.onnx")) if d.is_dir() else []
    lang = voice_lang(v)   # a voice of your language first (it_IT-paola-medium.onnx for "it")
    found = [f for f in found if f.name.lower().startswith(lang + "_")] + [f for f in found if not f.name.lower().startswith(lang + "_")]
    return str(found[0]) if found else None


def piper_tts() -> str | None:
    """piper-tts (AUR) or pip's `piper`; not the mouse tool also called piper."""
    if shutil.which("piper-tts"):
        return shutil.which("piper-tts")
    p = shutil.which("piper")
    try:
        return p if p and "piper.__main__" in Path(p).read_text(errors="ignore")[:2000] else None
    except OSError:
        return None


def speak(text: str, v: dict) -> None:
    """One line, aloud. A `command` of your own gets the text on stdin; else piper, else espeak-ng."""
    if v.get("command"):
        subprocess.run(["bash", "-c", str(v["command"])], input=text.encode(), timeout=60,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    piper = piper_tts()
    model = voice_model(v)
    player = next(([p] for p in ("pw-play", "paplay", "aplay") if shutil.which(p)), None)
    if piper and model and player:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        wav = STATE_DIR / "voice.wav"
        subprocess.run([piper, "--model", model, "--output_file", str(wav)], input=text.encode(), timeout=60,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        subprocess.run(player + [str(wav)], timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if shutil.which("espeak-ng"):
        subprocess.run(["espeak-ng", "-v", str(v.get("espeak_voice") or ("en-us" if voice_lang(v) == "en" else voice_lang(v))), "-s", "165", text], timeout=60, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        return
    log("voice: " + ("no audio player (pw-play, paplay or aplay)" if piper and model else
                     "install piper-tts and a voice in ~/.local/share/piper/, or espeak-ng"))


def github_activity(events: list, login: str = "", now: float | None = None) -> dict:
    """Your GitHub week, from the events API: pushes (and their commits), new branches, merged pull requests, releases."""
    now = now or time.time()
    week, day = now - 7 * 86400, time.mktime(time.localtime(now)[:3] + (0, 0, 0, 0, 0, -1))
    out = {"login": login, "pushes": 0, "commits": 0, "branches": 0, "merged": 0, "opened": 0, "releases": 0,
           "today": 0, "repos": [], "last_push": 0.0, "last_repo": "", "events": []}
    for e in events or []:
        t = iso_ts(e.get("created_at")) or 0
        if t < week:
            continue
        kind, pl, repo = e.get("type"), e.get("payload") or {}, (e.get("repo") or {}).get("name", "")
        if kind == "PushEvent":
            n = pl.get("distinct_size") or pl.get("size") or len(pl.get("commits") or []) or 1
            out["events"].append([str(e.get("id") or ""), "commit", int(n)])
            out["pushes"] += 1
            out["commits"] += int(n)
            if t >= day:
                out["today"] += int(n)
            if t > out["last_push"]:
                out["last_push"], out["last_repo"] = t, repo.split("/")[-1]
        elif kind == "CreateEvent" and pl.get("ref_type") == "branch":
            out["events"].append([str(e.get("id") or ""), "branch", 1])
            out["branches"] += 1
        elif kind == "PullRequestEvent" and pl.get("action") == "closed" and (pl.get("pull_request") or {}).get("merged"):
            out["merged"] += 1
        elif kind == "PullRequestEvent" and pl.get("action") == "opened":
            out["opened"] += 1
        elif kind == "ReleaseEvent" and pl.get("action") in ("published", "released", "created"):
            out["events"].append([str(e.get("id") or ""), "release", 1])
            out["releases"] += 1
        else:
            continue
        if repo and repo not in out["repos"]:
            out["repos"].append(repo)
    return out


def fuel_level(repos: list, goal=60, gh: dict | None = None) -> dict:
    """The garage's fuel gauge: what you shipped in the last 7 days, so the tank drains by itself if you stop.
    From your Git repositories: a point a commit, one more when it is pushed, three a branch you worked on.
    Linked to GitHub (gh auth login) it also sees your other machines: two points a push, three a new branch, five a
    merged pull request, ten a release. The same commit is never counted twice (the larger of the two counts wins)."""
    try:
        goal = max(1.0, float(goal))
    except (TypeError, ValueError):
        goal = 60.0
    commits = sum(int(r.get("week") or 0) for r in repos)
    pushed = sum(int(r.get("pushed") or 0) for r in repos)
    branches = sum(int(r.get("branches") or 0) for r in repos)
    today = sum(int(r.get("today") or 0) for r in repos)
    extra = {"source": "git", "login": "", "pushes": 0, "merged": 0, "shipped": 0}
    if gh:
        commits, branches, today = max(commits, gh["commits"]), max(branches, gh["branches"]), max(today, gh["today"])
        extra = {"source": "github", "login": gh["login"], "pushes": gh["pushes"], "merged": gh["merged"],
                 "shipped": gh["releases"]}
        points = commits + 2 * gh["pushes"] + 3 * branches + 5 * gh["merged"] + 10 * gh["releases"]
    else:
        points = commits + pushed + 3 * branches
    return {**extra, "level": round(min(1.0, points / goal), 3), "points": points, "goal": int(goal), "commits": commits,
            "pushed": pushed, "branches": branches, "today": today,
            "repos": sum(1 for r in repos if r.get("week")), "allCommits": sum(int(r.get("total") or 0) for r in repos),
            "releases": sum(int(r.get("tags") or 0) for r in repos)}


def canopy_conf(c: dict) -> dict:
    """[canopy] with its defaults."""
    out = dict(CANOPY_DEFAULTS)
    for k, v in (c or {}).items():
        if k not in out:
            continue
        d = out[k]
        if isinstance(d, bool):
            out[k] = bool(v)
        elif isinstance(d, (int, float)):
            try:
                out[k] = max(10.0, float(v))
            except (TypeError, ValueError):
                pass
        else:
            out[k] = str(v) if str(v) in CANOPY_CHOICES.get(k, ()) else out[k]
    return out


def canopy_growth(totals: dict, events: list, state: dict, conf: dict, vigor: float = 0.0, now: float | None = None):
    """CommitCanopy's tree. Planted the first time it runs; from then on every commit adds leaves, every branch a limb,
    every release blooms. Your history before planting gives it a head start (a young tree, not a grown one), unless
    [canopy] start = "history". It never shrinks: the highest count ever seen is kept, and GitHub events (pushes from
    other machines) are counted once each. Returns what the scene draws and the state to save."""
    now = now or time.time()
    st = json.loads(json.dumps(state or {}))
    if not st.get("planted"):
        st = {"planted": now, "base": dict(totals), "max": dict(totals), "gh": {"commit": 0, "branch": 0, "release": 0},
              "seen": []}
    for k in ("commits", "heads", "tags"):
        st["max"][k] = max(int(st["max"].get(k, 0)), int(totals.get(k, 0)))
    seen = set(st.get("seen") or [])
    for eid, kind, n in events or []:
        if eid and eid not in seen and kind in st["gh"]:
            st["gh"][kind] += int(n)
            seen.add(eid)
            st["seen"] = (st.get("seen") or []) + [eid]
    st["seen"] = (st.get("seen") or [])[-500:]
    base, mx, gh = st["base"], st["max"], st["gh"]
    grown = {"leaves": max(mx["commits"] - base.get("commits", 0), gh["commit"]),
             "limbs": max(mx["heads"] - base.get("heads", 0), gh["branch"]),
             "blooms": max(mx["tags"] - base.get("tags", 0), gh["release"])}
    pace = max(10.0, float(conf.get("pace", 400)))
    pts = grown["leaves"] + 6 * grown["limbs"] + 15 * grown["blooms"]
    past = base.get("commits", 0) + 6 * base.get("heads", 0) + 15 * base.get("tags", 0)
    if conf.get("start") == "history":
        growth = 1 - math.exp(-(pts + past) / pace)
    else:
        head = 0.35 * (1 - math.exp(-past / 1500))   # your history: a head start, never a full tree on day one
        growth = head + (1 - head) * (1 - math.exp(-pts / pace))
    growth = round(min(1.0, growth), 4)
    stage = next(name for lim, name in STAGES if growth < lim)
    view = {"growth": growth, "stage": stage, "planted": st["planted"], "days": int((now - st["planted"]) // 86400),
            "leaves": max(mx["commits"], base.get("commits", 0) + gh["commit"]), "limbs": mx["heads"] + gh["branch"],
            "blooms": mx["tags"] + gh["release"], "grown": grown, "vigor": round(float(vigor or 0), 3),
            "seed": int(st["planted"]) % 100000}
    return view, st


def garage_conf(c: dict) -> dict:
    """[garage] with its defaults: the warning thresholds (%) and what the garage shows."""
    out = dict(GARAGE_DEFAULTS)
    for k, v in (c or {}).items():
        if k not in out:
            continue
        if isinstance(GARAGE_DEFAULTS[k], bool):
            out[k] = v is not False
        elif isinstance(GARAGE_DEFAULTS[k], (int, float)):
            try:
                out[k] = max(1.0, min(100000.0, float(v)))
            except (TypeError, ValueError):
                pass
        elif k in GARAGE_TEXT:
            out[k] = str(v)[:80]
        else:
            out[k] = str(v) if str(v) in GARAGE_CHOICES.get(k, ()) else out[k]
    return out


def garage_plate(conf: dict) -> Path | None:
    """The picture behind the garage: [garage] plate, else garage.jpg/png/webp in ~/.config/omarchy-pulse, else the one
    that ships with Pulse.
    Only images: the path comes from your config, but a page must never read any other file through it."""
    mine = [str(CONF_DIR / ("garage" + ext)) for ext in (".jpg", ".png", ".webp")]   # dropped in the config folder
    for f in [str((conf or {}).get("plate") or "")] + mine + [str(WEB / "garage" / "plate.jpg")]:
        if not f:
            continue
        p = Path(os.path.expanduser(f))
        if p.suffix.lower() in PLATE_TYPES and p.is_file():
            return p
    return None


def plate_anchors(plate: Path | None) -> dict:
