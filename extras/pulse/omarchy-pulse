    # -- your year, counted: Pulse Wrapped
    def stat(self, key: str, n: float = 1, unique: str = "") -> None:
        try:
            year = time.strftime("%Y")
            f = STATE_DIR / "stats.json"
            with self.lock:
                d = json.loads(f.read_text()) if f.exists() else {}
                y = d.setdefault(year, {})
                if unique:   # count each one once (a plane's code, a quake's id), kept only as a short hash
                    import hashlib
                    h = hashlib.sha1(unique.encode()).hexdigest()[:10]
                    seen = y.setdefault("_" + key, [])
                    if h in seen:
                        return
                    seen.append(h)
                    if len(seen) > 20000:
                        del seen[:5000]
                y[key] = round(y.get(key, 0) + n, 1)
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                f.write_text(json.dumps(d))
        except (OSError, ValueError) as e:
            log(f"stats: {e}")

    def loop_wrapped(self) -> None:
        while True:
            time.sleep(300)
            lt = time.localtime()
            if (self.conf("wrapped", "enabled", default=True) is not False and lt.tm_mon == 12 and lt.tm_mday == 31
                    and lt.tm_hour >= 20 and self.__dict__.get("wrapped_done") != lt.tm_year):
                self.wrapped_done = lt.tm_year
                out = make_wrapped(str(lt.tm_year), self.conf("timelapse", default={}) or {})
                if out:
                    self.add_fx("fireworks", f"your {lt.tm_year} · Pulse Wrapped")
                    self.note("timelapse", "your year as a video: " + out.name, "ok")
                    self.phone("wrapped", f"Your {lt.tm_year} · Pulse Wrapped", str(out), "tada")
                    if shutil.which("notify-send"):
