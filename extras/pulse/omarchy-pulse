def with_scene(text: str, name: str) -> str:
    """pulse.toml with [pulse] scene set to NAME, the rest of the file (and its comments) untouched."""
    line = f'scene = "{name}"'
    new, n = re.subn(r'(?m)^scene\s*=\s*"[^"\n]*"', line, text, count=1)
    if n:
        return new
    if re.search(r"(?m)^\[pulse\]\s*$", text):
        return re.sub(r"(?m)^\[pulse\]\s*$", "[pulse]\n" + line, text, count=1)
    return "[pulse]\n" + line + "\n\n" + text


def git_info(path) -> dict | None:
    def g(*a):
        try:
            r = subprocess.run(["git", "-C", str(path), *a], capture_output=True, timeout=5, text=True)
        except (OSError, subprocess.TimeoutExpired):
            return ""
        return r.stdout.strip() if r.returncode == 0 else ""
    head = g("rev-parse", "HEAD")
    if not head:
        return None
    week = g("rev-list", "--count", "--since=7.days", "HEAD")
    today = g("rev-list", "--count", "--since=midnight", "HEAD")
    pushed = g("rev-list", "--count", "--since=7.days", "@{u}")   # this week's commits that reached the remote
    cut = time.time() - 7 * 86400
    branches = sum(1 for x in g("for-each-ref", "--format=%(committerdate:unix)", "refs/heads").split()
                   if x.isdigit() and int(x) > cut)   # branches with work on them this week
    last = g("log", "-1", "--format=%ct")
    total = g("rev-list", "--count", "HEAD")
    tags = len(g("tag", "--list").split())
    heads = len(g("for-each-ref", "--format=x", "refs/heads").split())
    return {"total": int(total) if total.isdigit() else 0, "tags": tags, "heads": heads,"head": head, "up": g("rev-parse", "@{u}"), "branch": g("rev-parse", "--abbrev-ref", "HEAD"),
            "week": int(week) if week.isdigit() else 0, "last": int(last) if last.isdigit() else 0,
            "today": int(today) if today.isdigit() else 0, "pushed": int(pushed) if pushed.isdigit() else 0,
            "branches": branches,
            "dirty": len([x for x in g("status", "--porcelain", "--untracked-files=no").splitlines() if x]),
            "remote": g("remote", "get-url", "origin")}


def github_slug(remote: str) -> str:
    m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", remote or "")
    return m.group(1) if m else ""


def gh_ci(slug: str, branch: str) -> str:
    try:
        r = subprocess.run(["gh", "run", "list", "-R", slug, "-b", branch, "-L", "1", "--json", "status,conclusion"],
                           capture_output=True, timeout=20, text=True)
        runs = json.loads(r.stdout or "[]") if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""
    if not runs:
        return ""
    if runs[0].get("status") != "completed":
        return "run"
    return "ok" if runs[0].get("conclusion") in ("success", "skipped", "neutral") else "fail"


def iss_at(track: list, now: float) -> dict | None:
    """The ISS position now, interpolated between the minute positions of wheretheiss.at."""
    pts = [p for p in track if isinstance(p, dict) and "timestamp" in p]
    for a, b in zip(pts, pts[1:]):
        if a["timestamp"] <= now <= b["timestamp"]:
            u = (now - a["timestamp"]) / max(1, b["timestamp"] - a["timestamp"])
            dl = (b["longitude"] - a["longitude"] + 540) % 360 - 180
            return {**a, "latitude": a["latitude"] + (b["latitude"] - a["latitude"]) * u,
                    "longitude": (a["longitude"] + dl * u + 540) % 360 - 180,
                    "altitude": a["altitude"] + (b["altitude"] - a["altitude"]) * u}
    return None



# ---------------------------------------------------------------- the real night sky (1.4): computed here, offline
# Low-precision formulas, good to a fraction of a degree for the Sun and the planets, about a degree for the Moon:
# far better than the eye needs on a wallpaper. Stars: J2000 positions of the bright ones you can recognise.

def julian(t: float) -> float:
    return t / 86400.0 + 2440587.5


def gmst_deg(jd: float) -> float:
    return (280.46061837 + 360.98564736629 * (jd - 2451545.0)) % 360


def altaz(ra: float, dec: float, lat: float, lon: float, jd: float) -> tuple:
    """Right ascension and declination (degrees) to azimuth (0 = north, 90 = east) and elevation, for (lat, lon)."""
    import math
    h = math.radians((gmst_deg(jd) + lon - ra) % 360)
    la, d = math.radians(lat), math.radians(dec)
    el = math.asin(max(-1.0, min(1.0, math.sin(la) * math.sin(d) + math.cos(la) * math.cos(d) * math.cos(h))))
    az = math.atan2(-math.sin(h) * math.cos(d), math.cos(la) * math.sin(d) - math.sin(la) * math.cos(d) * math.cos(h))
    return (math.degrees(az) + 360) % 360, math.degrees(el)


def ecl_to_eq(lon: float, lat: float, eps: float = 23.4393) -> tuple:
    import math
    lo, la, e = math.radians(lon), math.radians(lat), math.radians(eps)
    x = math.cos(la) * math.cos(lo)
    y = math.cos(e) * math.cos(la) * math.sin(lo) - math.sin(e) * math.sin(la)
    z = math.sin(e) * math.cos(la) * math.sin(lo) + math.cos(e) * math.sin(la)
    return (math.degrees(math.atan2(y, x)) + 360) % 360, math.degrees(math.asin(max(-1.0, min(1.0, z))))


def sun_ecl(jd: float) -> float:
    """The Sun's ecliptic longitude (degrees)."""
    import math
    n = jd - 2451545.0
    L, g = (280.460 + 0.9856474 * n) % 360, math.radians((357.528 + 0.9856003 * n) % 360)
    return (L + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g)) % 360


def sun_radec(jd: float) -> tuple:
    return ecl_to_eq(sun_ecl(jd), 0.0, 23.439 - 0.0000004 * (jd - 2451545.0))


def moon_ecl(jd: float) -> tuple:
    """The Moon's geocentric ecliptic longitude and latitude (degrees), with its main perturbations."""
    import math
    rad, d = math.radians, jd - 2451543.5
    N, i, w = 125.1228 - 0.0529538083 * d, 5.1454, 318.0634 + 0.1643573223 * d
    e, M = 0.054900, (115.3654 + 13.0649929509 * d) % 360
    E = rad(M)
    for _ in range(8):
        E = E - (E - e * math.sin(E) - rad(M)) / (1 - e * math.cos(E))
    xv, yv = math.cos(E) - e, math.sqrt(1 - e * e) * math.sin(E)
    v, r = math.atan2(yv, xv), math.hypot(xv, yv)
    vw, Nr, ir = v + rad(w), rad(N), rad(i)
    xh = r * (math.cos(Nr) * math.cos(vw) - math.sin(Nr) * math.sin(vw) * math.cos(ir))
    yh = r * (math.sin(Nr) * math.cos(vw) + math.cos(Nr) * math.sin(vw) * math.cos(ir))
    zh = r * math.sin(vw) * math.sin(ir)
    lon, lat = math.degrees(math.atan2(yh, xh)), math.degrees(math.atan2(zh, math.hypot(xh, yh)))
    Ms = rad((356.0470 + 0.9856002585 * d) % 360)
    Mm = rad(M)
    Ls = (Ms + rad(282.9404 + 4.70935e-5 * d))
    Lm = Nr + rad(w) + rad(M)
    D, F = Lm - Ls, Lm - Nr
    s = math.sin
    lon += (-1.274 * s(Mm - 2 * D) + 0.658 * s(2 * D) - 0.186 * s(Ms) - 0.059 * s(2 * Mm - 2 * D) - 0.057 * s(Mm - 2 * D + Ms)
            + 0.053 * s(Mm + 2 * D) + 0.046 * s(2 * D - Ms) + 0.041 * s(Mm - Ms) - 0.035 * s(D) - 0.031 * s(Mm + Ms)
            - 0.015 * s(2 * F - 2 * D) + 0.011 * s(Mm - 4 * D))
    lat += (-0.173 * s(F - 2 * D) - 0.055 * s(Mm - F - 2 * D) - 0.046 * s(Mm + F - 2 * D) + 0.033 * s(F + 2 * D) + 0.017 * s(2 * Mm + F))
    return lon % 360, lat


def moon_phase(jd: float) -> dict:
    """How much of the Moon is lit (0..1), whether it grows, its age in days and its name."""
    import math
    elong = (moon_ecl(jd)[0] - sun_ecl(jd)) % 360
    lit = (1 - math.cos(math.radians(elong))) / 2
    waxing = elong < 180
    age = elong / 360 * 29.530589
    name = ("new moon" if lit < 0.03 else "full moon" if lit > 0.97 else
            ("first quarter" if waxing else "last quarter") if abs(lit - 0.5) < 0.06 else
            ("waxing crescent" if waxing else "waning crescent") if lit < 0.5 else ("waxing gibbous" if waxing else "waning gibbous"))
    return {"lit": round(lit, 3), "waxing": waxing, "age": round(age, 1), "name": name}


