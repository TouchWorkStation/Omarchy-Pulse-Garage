def growth_streak(ts: list, now: float | None = None) -> int:
    """Days in a row with at least one finished focus, up to today (or yesterday, if today has none yet)."""
    days, now = growth_days(ts), now if now is not None else time.time()
    d = now if time.strftime("%Y-%m-%d", time.localtime(now)) in days else now - 86400
    n = 0
    while time.strftime("%Y-%m-%d", time.localtime(d)) in days:
        n += 1
        d -= 86400
    return n


