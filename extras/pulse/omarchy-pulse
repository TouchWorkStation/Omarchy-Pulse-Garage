                time.sleep(120)
                continue
            try:
                r = subprocess.run([tool, "ps", "--format", "{{json .}}"], capture_output=True, text=True, timeout=10)
                self.robots = containers(r.stdout) if r.returncode == 0 else []
            except (OSError, subprocess.TimeoutExpired):
