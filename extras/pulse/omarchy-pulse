    # -- your electric car: Tessie (a Tesla) or Home Assistant (any car it knows). Never its position.
    def tessie(self, path: str, post: bool = False):
        c = self.conf("car", default={}) or {}
        tok = str(c.get("token") or "")
        if not tok and c.get("token_file"):
            tok = Path(str(c["token_file"])).expanduser().read_text().strip()
        req = urllib.request.Request("https://api.tessie.com" + path, data=b"" if post else None, method="POST" if post else "GET",
                                     headers={"Authorization": "Bearer " + tok, "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=40 if post else 10) as r:
            return json.loads(r.read(2_000_000) or b"null")

    def car_read(self, c: dict) -> dict | None:
        km = self.conf("pulse", "units", default="metric") != "imperial"
        if str(c.get("source", "tessie")) == "tessie":
            vs = [v for v in (self.tessie("/vehicles?only_active=true").get("results") or []) if v.get("last_state")]
            v = next((x for x in vs if not c.get("vin") or x.get("vin") == c.get("vin")), None)
            if not v:
                return None
            self.car_vin = v["vin"]
            s = v["last_state"]   # Tessie's last state: reading it never wakes the car
            ch, cl, vh, dr = (s.get("charge_state") or {}), (s.get("climate_state") or {}), (s.get("vehicle_state") or {}), (s.get("drive_state") or {})
            rng = ch.get("battery_range")   # Tesla gives miles
            return car_view(ch.get("battery_level"), rng * 1.609 if km and rng is not None else rng, km,
                            str(ch.get("charging_state") or ""), ch.get("charge_limit_soc"), ch.get("minutes_to_full_charge"),
                            ch.get("charger_power"), vh.get("locked"), cl.get("is_climate_on"), cl.get("inside_temp"),
                            str(dr.get("shift_state") or "") in ("D", "R", "N"))
        g = lambda k: (self.ha("/api/states/" + urllib.parse.quote(str(c[k]))) or {}).get("state") if c.get(k) else None   # noqa: E731
        num = lambda x: float(x) if x not in (None, "", "unknown", "unavailable") else None   # noqa: E731
        chg = g("charging")
        state = "Charging" if chg in ("on", "charging", "Charging") else ("Stopped" if g("plugged") == "on" else "Disconnected")
        return car_view(num(g("battery")), num(g("range")), km, state, num(g("limit")), None, None,
                        {"locked": True, "unlocked": False}.get(str(g("lock"))), {"off": False}.get(str(g("climate")), None if not c.get("climate") else True),
                        num(g("inside")), False)

    def loop_car(self) -> None:
        last, warned, told = None, 0.0, ""
        while True:
            c = self.conf("car", default={}) or {}
            if not c.get("enabled") or self.demo:
                time.sleep(20)
                continue
            now = time.time()
            try:
                v = self.car_read(c)
                if v:
                    v["name"] = str(c.get("name") or "car")[:16]
                    self.car = {**v, "t": now}
                    self.car_events(last, v, c)
                    last = v
                    self.car_widget(c)
                day = time.strftime("%Y-%m-%d")
                if v and time.strftime("%H:%M") >= str(c.get("evening", "21:00")) and told != day:
                    told = day
                    if v["battery"] is not None and v["battery"] < float(c.get("low", 30) or 30) and v["state"] == "Disconnected":
                        self.note("car", f"{v['name']} at {v['battery']:.0f}% and not plugged in", "warn")
                        self.say(self.T("car_low", name=v['name'], b=f"{v['battery']:.0f}"), "car")
                        self.phone("car", f"{v['name']} at {v['battery']:.0f}% and not plugged in", "", "electric_plug")
            except Exception as e:   # noqa: BLE001
                if now - warned > 900:
                    warned = now
                    log(f"car: {e}")
            time.sleep(max(30, int(c.get("every", 60) or 60)))

    def car_events(self, last: dict | None, v: dict, c: dict) -> None:
        if not last:
            return
        if v["state"] == "Charging" and last["state"] != "Charging":
            self.add_fx("car", f"{v['name']} charging · {v['battery']:.0f}%", small=True)
            self.note("car", f"{v['name']} started charging at {v['battery']:.0f}%", "info")
        if last["state"] == "Charging" and v["state"] == "Complete":
            self.add_fx("car", f"{v['name']} charged · {v['battery']:.0f}% · {v['range']:.0f} {v['unit']}")
            self.note("car", f"{v['name']} charged: {v['battery']:.0f}%", "ok")
            self.say(self.T("car_done", name=v['name'], b=f"{v['battery']:.0f}"), "car")
            self.phone("car", f"{v['name']} charged · {v['battery']:.0f}%", f"{v['range']:.0f} {v['unit']}" if v.get("range") is not None else "", "battery")

    def car_widget(self, c: dict) -> None:
        v = self.car or {}
        b = v.get("battery")
        items = [{"title": "battery", "level": "ok" if (b or 0) >= 50 else "warn" if (b or 0) >= 20 else "crit",
                  "note": (f"{b:.0f}%" if b is not None else "--") + (f" · {v['range']:.0f} {v['unit']}" if v.get("range") is not None else "")}]
        cmds = [""]   # the battery row does nothing
        ch = v.get("state") == "Charging"
        if v.get("state") in ("Charging", "Stopped", "Complete") or ch:
            items.append({"title": "stop charging" if ch else "charge", "level": "ok" if ch else "",
                          "note": (f"{v['power']:.0f} kW" if ch and v.get("power") else v.get("state", "").lower())[:10]})
            cmds.append("stop_charging" if ch else "start_charging")
        if v.get("locked") is not None:
            if v["locked"]:
                if c.get("allow_unlock"):
                    items.append({"title": "unlock", "level": "ok", "note": "locked"}); cmds.append("unlock")
                else:
                    items.append({"title": "locked", "level": "ok", "note": ""}); cmds.append("")
            else:
                items.append({"title": "lock", "level": "warn", "note": "open"}); cmds.append("lock")
        if v.get("climate") is not None:
            items.append({"title": "climate", "level": "ok" if v["climate"] else "",
                          "note": ("on" if v["climate"] else "off") + (f" · {v['inside']:.0f}°" if v.get("inside") is not None else "")})
            cmds.append("stop_climate" if v["climate"] else "start_climate")
        self.car_cmds = cmds
        self.set_widget("car", title=str(v.get("name") or "car"), type="status", slot=str(c.get("panel", "right")), order=36,
                        icon="󰄋", data={"items": items}, itemclick=True)

    def car_allowed(self, cmd: str) -> bool:
        c = self.conf("car", default={}) or {}
        if not (c.get("enabled") or self.demo) or cmd not in ("start_charging", "stop_charging", "lock", "unlock",
                                                              "start_climate", "stop_climate", "flash"):
            return False
        return cmd != "unlock" or bool(c.get("allow_unlock"))   # never unlocked from the wallpaper, unless you said so

    def car_run(self, cmd: str) -> None:
        try:
            ok = self.car_command(cmd)
            self.note("car", f"{cmd.replace('_', ' ')}: " + ("done" if ok else "no answer"), "info" if ok else "warn")
            if ok and not self.demo:
                self.car_refresh()
        except Exception as e:   # noqa: BLE001
            log(f"car: {e}")

    def car_command(self, cmd: str) -> bool:
        c = self.conf("car", default={}) or {}
        if not self.car_allowed(cmd):
            return False
        if self.demo:
            v = self.car or {}
            if cmd.endswith("charging"):
                v["state"] = "Charging" if cmd == "start_charging" else "Stopped"
            elif cmd in ("lock", "unlock"):
                v["locked"] = cmd == "lock"
            elif cmd.endswith("climate"):
                v["climate"] = cmd == "start_climate"
            self.car_widget(c)
            return True
        if str(c.get("source", "tessie")) == "tessie":
            if not getattr(self, "car_vin", None):
                return False
            return bool((self.tessie(f"/{self.car_vin}/command/{'flash' if cmd == 'flash' else cmd}?wait_for_completion=true", post=True) or {}).get("result"))
        ent = {"start_charging": "charge_switch", "stop_charging": "charge_switch", "lock": "lock", "unlock": "lock",
               "start_climate": "climate", "stop_climate": "climate"}.get(cmd)
        if not ent or not c.get(ent):
            return False
        e = str(c[ent]); dom = e.split(".")[0]
        svc = {"lock": "lock", "unlock": "unlock"}.get(cmd) or ("turn_on" if cmd.startswith("start") else "turn_off")
        self.ha(f"/api/services/{dom}/{svc}", {"entity_id": e})
        return True

    # -- your phone: the moments that matter, as a push notification (the ntfy app, free on iOS and Android)
    def phone(self, kind: str, title: str, text: str = "", tags: str = "", private_text: bool = False) -> None:
        c = self.conf("phone", default={}) or {}
        if not c.get("topic") or c.get("enabled") is False or self.demo:
            return
        if kind not in (c.get("events") or ["focus", "doorbell", "car", "earth", "calendar", "space", "alerts", "wrapped"]):
            return
        if private_text and c.get("details") is False:
            text = ""

        def send():
            server = str(c.get("server") or "https://ntfy.sh").rstrip("/")
            msg = {"topic": str(c["topic"]), "title": title[:120], "message": (text or title)[:400],
                   "tags": [tags or "city_sunset"], "priority": 4 if kind in ("doorbell", "alerts", "earth") else 3}
            headers = {"Content-Type": "application/json"}
            if c.get("token"):
                headers["Authorization"] = "Bearer " + str(c["token"])
            try:   # JSON publishing: titles in any language
                urllib.request.urlopen(urllib.request.Request(server, data=json.dumps(msg).encode(), method="POST",
                                                              headers=headers), timeout=10).read()
            except Exception as e:   # noqa: BLE001
                log(f"phone: {e}")
        threading.Thread(target=send, daemon=True).start()

    # -- the lights of your room follow Pulse (Home Assistant, Philips Hue, a Philips TV's Ambilight through HA)
    def room(self) -> dict:
        return self.conf("lights", default={}) or {}

    def room_lights(self) -> list:
        c = self.room()
        return [str(x) for x in (c.get("lights") or [])][:12] if c.get("enabled") else []

    def hue(self, path: str, body: dict | None = None):
        c = self.room()
        req = urllib.request.Request(f"http://{c.get('bridge')}/api/{c.get('user')}{path}",
                                     data=json.dumps(body).encode() if body is not None else None,
                                     method="PUT" if body is not None else "GET", headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read() or b"null")

    def light_get(self, ent: str) -> dict:
        """A light as it is now: on or off, brightness 0..255, colour (rgb) or white (mired)."""
        if str(self.room().get("source", "homeassistant")) == "hue":
            st = (self.hue(f"/lights/{ent}") or {}).get("state") or {}
            return {"on": bool(st.get("on")), "bri": st.get("bri"), "xy": st.get("xy"), "ct": st.get("ct")}
        st = self.ha("/api/states/" + urllib.parse.quote(ent)) or {}
        a = st.get("attributes") or {}
        return {"on": st.get("state") == "on", "bri": a.get("brightness"), "rgb": a.get("rgb_color"),
                "mired": a.get("color_temp")}

    def light_set(self, ent: str, on: bool = True, rgb=None, bri=None, back: dict | None = None, flash_ms: int = 0) -> None:
        hue = str(self.room().get("source", "homeassistant")) == "hue"
        if back is not None:   # put it back exactly as it was
            if hue:
                body = {"on": back["on"]}
                if back["on"]:
                    body.update({k: back[k] for k in ("bri", "xy", "ct") if back.get(k) is not None})
                    if body.get("xy") is not None:
                        body.pop("ct", None)
                self.hue(f"/lights/{ent}/state", {**body, "transitiontime": 2})
            elif not back["on"]:
                self.ha("/api/services/light/turn_off", {"entity_id": ent})
            else:
                body = {"entity_id": ent, "transition": 0.3}
                if back.get("bri") is not None:
                    body["brightness"] = back["bri"]
                if back.get("rgb"):
                    body["rgb_color"] = back["rgb"]
                elif back.get("mired"):
                    body["color_temp"] = back["mired"]
                self.ha("/api/services/light/turn_on", body)
            return
        if hue:
            body: dict = {"on": on, "transitiontime": 0}
            if on and rgb:
                body["xy"] = rgb_to_xy(rgb)
            if on and bri is not None:
                body["bri"] = max(1, min(254, int(bri)))
            self.hue(f"/lights/{ent}/state", body)
        else:
            body = {"entity_id": ent, "transition": 0}
            if on and rgb:
                body["rgb_color"] = list(rgb)
            if on and bri is not None:
                body["brightness"] = max(1, min(255, int(bri)))
            self.ha("/api/services/light/" + ("turn_on" if on else "turn_off"), body)

    def room_effect(self, kind: str) -> None:
        """A short effect on the room's lights (in its own thread), then every light goes back as it was."""
        c, ents = self.room(), self.room_lights()
        if not ents or self.demo or c.get(kind, True) is False:
            return
        if not self.__dict__.setdefault("room_lock", threading.Lock()).acquire(blocking=False):
            return   # one effect at a time

        def run():
            try:
                before = {e: self.light_get(e) for e in ents}
                use = [e for e in ents if before[e]["on"] or c.get("only_if_on", True) is False]
                steps = {"lightning": [((255, 255, 255), 255, 0.12), (None, None, 0.08), ((235, 240, 255), 200, 0.1)],
                         "alert": [((255, 30, 40), 255, 0.5), (None, None, 0.35)] * 3,
                         "doorbell": [((255, 255, 255), 255, 0.35), (None, None, 0.3)] * 2,
                         "quake": [((255, 150, 40), 255, 0.15), ((255, 150, 40), 60, 0.15)] * 5}.get(kind)
                if kind == "focus":   # a calm colour while you focus; back when it ends
                    for e in use:
                        self.light_set(e, True, (90, 110, 255), int(c.get("focus_brightness", 90) or 90))
                    self.room_before = before
                    return
                for rgb, bri, secs in steps or []:
                    for e in use:
                        if rgb is None:
                            self.light_set(e, back=before[e])
                        else:
                            self.light_set(e, True, rgb, bri)
                    time.sleep(secs)
                for e in use:
                    self.light_set(e, back=before[e])   # as it was just before (the focus colour, if a focus runs)
            except Exception as ex:   # noqa: BLE001
                log(f"lights: {ex}")
            finally:
                self.room_lock.release()

        def end_focus():
            try:
                b = self.__dict__.pop("room_before", None) or {}
                for e, st in b.items():
                    if st["on"] or c.get("only_if_on", True) is False:
                        self.light_set(e, back=st)
            except Exception as ex:   # noqa: BLE001
                log(f"lights: {ex}")
            finally:
                self.room_lock.release()
        threading.Thread(target=end_focus if kind == "focus_end" else run, daemon=True).start()

    # -- the real sky at night: computed here every minute for where you are (no internet needed)
    def loop_night(self) -> None:
        while True:
            try:
                if self.location and self.conf("night", "enabled", default=True) is not False:
                    self.night = night_sky(*self.location, time.time() + float(os.environ.get("PULSE_DEMO_SKY_OFFSET") or 0))
                    fl = os.environ.get("PULSE_DEMO_SHOWER", "")
                    if self.demo and fl and os.path.exists(fl):   # the demo video: a strong shower while its flag file exists
                        sh0 = meteor_shower(time.time() + float(os.environ.get("PULSE_DEMO_SKY_OFFSET") or 0)) or {}
                        self.night["shower"] = {"name": sh0.get("name", "Leonids"), "zhr": 1000.0, "strength": 1.0, "az": 110.0, "el": 25.0}
                    sh = self.night.get("shower")
                    day = time.strftime("%Y-%m-%d")
                    if sh and sh["strength"] > 0.7 and self.night["sun"]["el"] < -12 and self.__dict__.get("shower_said") != day:
                        self.shower_said = day
                        self.note("space", f"{sh['name']} meteor shower tonight", "info")
                        self.say(self.T("shower", name=sh["name"]), "space")
            except Exception as e:   # noqa: BLE001
