            time.sleep(60 if not self.demo else 1)

    # -- Starlink trains: the satellites of the last launches, when they really pass over you, lit by the Sun
    def loop_starlink(self) -> None:
        groups, fetched, planned, passes, warned, told = {}, 0.0, 0.0, [], 0.0, set()
        cache = STATE_DIR / "starlink.json"
        while True:
            c = self.conf("starlink", default={}) or {}
            if c.get("enabled") is False or self.demo or not self.location:
                time.sleep(30)
                continue
            now = time.time()
            try:
                if now - fetched > 6 * 3600:   # CelesTrak asks for no more than every few hours
                    fetched = now
                    rows = None
                    try:
                        if cache.exists() and now - cache.stat().st_mtime < 6 * 3600:
                            rows = json.loads(cache.read_text())
                    except (OSError, ValueError):
                        rows = None
                    if rows is None:
                        rows = http_json("https://celestrak.org/NORAD/elements/gp.php?GROUP=last-30-days&FORMAT=json")
                        STATE_DIR.mkdir(parents=True, exist_ok=True)
                        cache.write_text(json.dumps(rows))
                    groups = starlink_groups(rows)
                    planned = 0
                lat, lon = self.location
                if groups and now - planned > 3600:
                    planned = now
                    passes = starlink_passes(groups, lat, lon, now, 24)
                passes = [p for p in passes if p["end"] > now]
                nxt = passes[0] if passes else None
                sats = []
                if nxt and nxt["start"] - 120 <= now <= nxt["end"] + 60:   # the train is over you: every satellite
                    for o in groups.get(nxt["group"], []):
                        az, el, lit = sat_look(o, lat, lon, now)
                        if el > 0 and lit:
                            sats.append({"az": round(az, 2), "el": round(el, 2)})
                warn = float(c.get("warn", 5) or 0) * 60
                if nxt and warn and 0 < nxt["start"] - now <= warn and nxt["group"] + str(int(nxt["start"])) not in told:
                    told.add(nxt["group"] + str(int(nxt["start"])))
                    at = time.strftime("%H:%M", time.localtime(nxt["start"]))
                    side = compass(nxt["az"])
                    self.add_fx("starlink", f"Starlink train at {at} · {side} · {nxt['n']} satellites")
                    self.note("space", f"a Starlink train passes at {at}, {nxt['max_el']}° high", "info")
                    self.say(self.T("starlink", at=at, side=side), "space")
                    self.phone("space", f"Starlink train at {at}", f"look {side}, {nxt['max_el']}° high · {nxt['n']} satellites", "satellite")
                    self.stat("starlink")
                self.starlink = {"sats": sats, "next": {k: nxt[k] for k in ("start", "end", "max_el", "az", "n")} if nxt else None}
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"starlink: {e}")
            time.sleep(4 if self.starlink.get("sats") else 20)

    # -- thunderstorms around you: the weather of 8 points around you, so a storm comes from where it really is
    def loop_storms(self) -> None:
        warned = 0.0
        while True:
            c = self.conf("storms", default={}) or {}
            if c.get("enabled") is False or self.demo or not self.location:
                time.sleep(60)
                continue
            try:
                lat, lon = self.location
                km = float(c.get("km", 30) or 30)
                pts = [ring_point(lat, lon, b, km) for b in range(0, 360, 45)] + [(lat, lon)]
                q = ("https://api.open-meteo.com/v1/forecast?latitude=" + ",".join(f"{p[0]:.3f}" for p in pts)
                     + "&longitude=" + ",".join(f"{p[1]:.3f}" for p in pts) + "&current=weather_code,precipitation")
                j = http_json(q)
                rows = j if isinstance(j, list) else [j]
                cells = []
                for b, row in zip(list(range(0, 360, 45)) + [None], rows):
                    code = (row.get("current") or {}).get("weather_code")
                    if isinstance(code, (int, float)) and code >= 95:
                        cells.append({"az": b, "km": 0 if b is None else km, "hail": code in (96, 99)})
                lpi = None
                try:   # the lightning potential (Central Europe, ICON): how charged the air really is
                    lj = http_json(f"https://api.open-meteo.com/v1/forecast?latitude={lat:.3f}&longitude={lon:.3f}"
                                   "&hourly=lightning_potential&forecast_hours=1")
                    lpi = ((lj.get("hourly") or {}).get("lightning_potential") or [None])[0]
                except Exception:   # noqa: BLE001 - outside Europe there is none
                    pass
                self.storms = {"cells": cells, "lpi": lpi, "t": time.time()}
                if any(not c_["km"] for c_ in cells) and not self.__dict__.get("room_storm"):
                    self.room_storm = True
                    threading.Thread(target=self.loop_room_storm, daemon=True).start()
            except Exception as e:   # noqa: BLE001
                if time.time() - warned > 3600:
                    warned = time.time()
                    log(f"storms: {e}")
            time.sleep(max(300, int(c.get("every", 600) or 600)))

    def loop_room_storm(self) -> None:
        """While the thunderstorm is over you, now and then a flash of lightning in your room too."""
        import random
        try:
            while self.storms and any(not c_["km"] for c_ in self.storms.get("cells", [])):
                time.sleep(random.uniform(25, 90))
                if not self.privacy() and not self.in_meeting:
                    self.room_effect("lightning")
        finally:
            self.room_storm = False

    def set_bot(self, name: str, state: str) -> None:
        """An AI bot of yours (Grok Bot, an n8n flow, a Discord bot...) as a robot on the floor, until it says gone."""
        name = re.sub(r"[^\w.:@\- ]", "", str(name or ""))[:20].strip() or "bot"
        st = {"ok": "ok", "idle": "ok", "working": "busy", "busy": "busy", "waiting": "restart", "restart": "restart",
              "failed": "bad", "bad": "bad", "error": "bad"}.get(str(state).lower(), "gone")
        with self.lock:
            if st == "gone":
                self.bots.pop(name, None)
            else:
                self.bots[name] = {"health": "ok" if st == "busy" else st, "busy": st == "busy", "t": time.time()}

    def all_robots(self) -> list:
        now = time.time()
        bots = [{"id": "b" + __import__("hashlib").sha1(n.encode()).hexdigest()[:7], "name": n, "health": b["health"],
                 "bot": True, "busy": b.get("busy", False)} for n, b in list(self.bots.items()) if now - b["t"] < 3600]
        return (bots + list(self.robots))[:12]

    # -- your containers (Docker or Podman) are robots walking on the floor of the city
    def loop_robots(self) -> None:
        while True:
            c = self.conf("robots", default={}) or {}
            src = str(c.get("source", "auto"))
            if c.get("enabled") is False or self.demo:
