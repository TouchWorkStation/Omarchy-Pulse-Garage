def helio(name: str, jd: float) -> tuple:
    import math
    el0, rate, _ = PLANETS[name]
    T = (jd - 2451545.0) / 36525
    a, e, I, L, wb, Om = (el0[k] + rate[k] * T for k in range(6))
    w, M = math.radians(wb - Om), math.radians(((L - wb) + 180) % 360 - 180)
    E = M + e * math.sin(M)
    for _ in range(10):
        E = E - (E - e * math.sin(E) - M) / (1 - e * math.cos(E))
    xp, yp = a * (math.cos(E) - e), a * math.sqrt(1 - e * e) * math.sin(E)
    I, Om = math.radians(I), math.radians(Om)
    cw, sw, cO, sO, cI, sI = math.cos(w), math.sin(w), math.cos(Om), math.sin(Om), math.cos(I), math.sin(I)
    return ((cw * cO - sw * sO * cI) * xp + (-sw * cO - cw * sO * cI) * yp,
            (cw * sO + sw * cO * cI) * xp + (-sw * sO + cw * cO * cI) * yp,
            (sw * sI) * xp + (cw * sI) * yp)


def planet_radec(name: str, jd: float) -> tuple:
    import math
    p, g = helio(name, jd), helio("earth", jd)
    x, y, z = p[0] - g[0], p[1] - g[1], p[2] - g[2]
    lon, lat = math.degrees(math.atan2(y, x)) % 360, math.degrees(math.atan2(z, math.hypot(x, y)))
    return ecl_to_eq(lon, lat)


