    # -- config
    def conf(self, *keys, default=None):
        d = self.cfg
        for k in keys:
            if not isinstance(d, dict) or k not in d:
                return default
            d = d[k]
        return d

    def reload(self, force: bool = False) -> None:
        try:
            m = CONF.stat().st_mtime
        except FileNotFoundError:
            m = 0
        if not force and m == self.cfg_mtime and self.cfg:
            return
        self.cfg_mtime = m
        cfg = load_config()
        with self.lock:
            self.cfg = cfg
            self.gen += 1
            gen = self.gen
            for p in self.procs:
                try:
                    p.terminate()
                except Exception:   # noqa: BLE001
                    pass
            self.procs = []
            keep = BUILTIN_IDS
            names = {str(s.get("name", "")) for s in cfg.get("source", []) if isinstance(s, dict)}
            for k in list(self.widgets):
                if k not in keep and k not in names and not self.widgets[k].get("pushed"):
                    del self.widgets[k]
        if cfg.get("_error"):
            self.set_widget("pulse.toml", title="pulse.toml", type="text", slot="center", level="crit",
                            data={"text": "Config error: " + cfg["_error"]})
        else:
            self.drop_widget("pulse.toml")
        if self.demo:
            return
        for i, src in enumerate(cfg.get("source", [])):
            if not isinstance(src, dict) or not src.get("name") or src.get("enabled") is False:
                continue
            src = dict(src)
            src["_order"] = i
            threading.Thread(target=self.run_source, args=(src, gen), daemon=True).start()
        log(f"config loaded: {len([s for s in cfg.get('source', []) if isinstance(s, dict)])} sources")

    # -- widgets
    def set_widget(self, wid: str, **f) -> None:
        notify = None
        with self.lock:
            w = self.widgets.get(wid) or {"id": wid, "title": wid, "type": "text", "slot": "auto", "data": {}}
            old = w.get("level")
            w.update({k: v for k, v in f.items() if v is not None})
            w["updated"] = time.time()
            if f.get("error") is None:
                w.pop("error", None)
            d = w.get("data") or {}
            if w.get("type") in ("stat", "gauge") and isinstance(d.get("value"), (int, float)):
                h = w.setdefault("_hist", collections.deque(maxlen=HIST))
                h.append(d["value"])
                d["history"] = list(h)
                rules = w.get("_rules") or {}
                lv = None
                for name, lvl, cmp in (("crit_above", "crit", 1), ("crit_below", "crit", -1),
                                       ("warn_above", "warn", 1), ("warn_below", "warn", -1)):
                    if name in rules and lv is None:
                        if (cmp > 0 and d["value"] > rules[name]) or (cmp < 0 and d["value"] < rules[name]):
                            lv = lvl
                if rules:
                    w["level"] = lv or "ok"
            new = w.get("level")
            if old in ("warn", "crit") and new == "ok" and self.conf("pulse", "celebrate", default=True) is not False:
                self.add_fx("burst", f"{w.get('title', wid)} · ok", small=True)   # back to green: a small burst
            if new in ("warn", "crit") and new != old:
                self.alert_seq += 1
                txt = ""
                if isinstance(d.get("value"), (int, float)):
                    txt = f"{d['value']:g} {d.get('unit', '')}".strip()
                elif d.get("text"):
                    txt = str(d["text"]).splitlines()[0][:120]
                elif d.get("items"):
                    bad = [i for i in d["items"] if i.get("level") in ("warn", "crit")]
                    txt = ", ".join(i.get("title", "") for i in (bad or d["items"])[:4])
                elif d.get("note"):
                    txt = d["note"]
                self.alerts.append({"seq": self.alert_seq, "id": wid, "title": w.get("title", wid), "text": txt,
                                    "level": new, "t": time.time()})
                self.note("alert", f"{w.get('title', wid)}" + (f" · {txt}" if txt else ""), new, bool(w.get("private")))
                if not w.get("private"):
                    self.say(self.T("alert", title=w.get('title', wid), text=txt), "alerts")
                if w.get("_notify"):
                    notify = (w.get("title", wid), txt, new)
            self.widgets[wid] = w
        if notify and shutil.which("notify-send"):
            subprocess.Popen(["notify-send", "-u", "critical" if notify[2] == "crit" else "normal",
                              "Pulse · " + notify[0], notify[1]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def raise_alert(self, wid: str, title: str, text: str, level: str, speak: bool = True) -> None:
        with self.lock:
            self.alert_seq += 1
            self.alerts.append({"seq": self.alert_seq, "id": wid, "title": title, "text": text, "level": level,
                                "t": time.time()})
        self.note("alert", f"{title}" + (f" · {text}" if text else ""), level)
        if level == "crit" or (level == "warn" and self.room().get("warn_too")):
            self.room_effect("alert")
        if level == "crit":
            self.phone("alerts", title, text, "rotating_light", private_text=True)
        if speak:
            self.say(f"{title}. {text}", "alerts")

    def note(self, kind: str, text: str, level: str = "info", private: bool = False) -> None:
        """While you are away, remember what happened for the digest."""
        with self.lock:
            a = self.away
            if not a:
                return
            ev = a["events"]
            if any(e["text"] == text for e in ev[-6:]):
                return
            if len(ev) < 40:
                ev.append({"kind": kind, "text": str(text)[:90], "level": level, "t": time.time(), "private": private})

    # -- effects, agents, focus
    def add_fx(self, kind: str, text: str = "", small: bool = False, **extra) -> None:
        with self.lock:
            self.fx_seq += 1
            self.fx.append({"seq": self.fx_seq, "kind": kind, "text": str(text or "")[:60], "small": small,
                            "t": time.time(), **{k: round(float(v), 2) for k, v in extra.items()
                                                 if isinstance(v, (int, float)) and k in ("mag", "az", "near", "tsunami")}})

    def set_agent(self, name: str, state: str, text: str = "") -> None:
        name = re.sub(r"[^\w.:@\- ·]", "", str(name or ""))[:32].strip() or "agent"
        st = str(state or "").lower()
        st = {"thinking": "working", "busy": "working", "run": "working", "running": "working", "start": "working",
              "started": "working", "input": "waiting", "ask": "waiting", "permission": "waiting", "blocked": "waiting",
              "ok": "done", "success": "done", "finished": "done", "complete": "done", "error": "failed",
              "fail": "failed", "stop": "gone", "end": "gone", "exit": "gone", "remove": "gone"}.get(st, st)
        now = time.time()
        with self.lock:
            if st == "gone":
                if self.agents.pop(name, None):
                    self.crew_send({"ev": "agent", "agent": name, "state": "gone"})
                return
            if st not in AGENT_STATES:
                st = "working"
            a = self.agents.get(name) or {"name": name, "since": now}
            prev = a.get("state")
            if st == "working" and prev != "working":
                a["since"] = now
            if st != prev:
                a["changed"] = now   # how long it has been waiting for you (the garage shows it)
            a.update(state=st, text=str(text or "")[:80], t=now)
            self.agents[name] = a
        if st == prev:
            return
        self.crew_send({"ev": "agent", "agent": name, "state": st})
        spoken = name.replace("·", ",")
        if st == "done":
            self.note("agent", f"{name} finished", "ok")
            self.say(self.T("agent_done", name=spoken), "agents")
            if self.conf("pulse", "celebrate", default=True) is not False:
                self.add_fx("fireworks", f"{name} · done", small=True)
        elif st == "waiting":
            self.say(self.T("agent_wait", name=spoken), "agents")
        elif st == "failed":
            self.raise_alert("agent:" + name, f"{name} failed", text or "the agent stopped with an error", "warn",
                             speak=False)
            self.say(self.T("agent_fail", name=spoken), "agents")

    def expire_agents(self) -> None:
        now = time.time()
        with self.lock:
            for n, a in list(self.agents.items()):
                age = now - a.get("t", now)
                if (a["state"] in ("done", "failed") and age > 90) or (a["state"] == "idle" and age > 600) or age > 3600:
                    del self.agents[n]
            for n, a in list(self.crew_agents.items()):
                age = now - a.get("t", now)
                if (a["state"] in ("done", "failed") and age > 90) or age > 3600:
                    del self.crew_agents[n]

    def set_focus(self, minutes: float, label: str = "") -> None:
        with self.lock:
            if minutes <= 0:
                was, self.focus = self.focus, None
                if was:
                    self.room_effect("focus_end")
                return
            now = time.time()
            self.focus = {"start": now, "until": now + minutes * 60, "label": str(label or "focus")[:40]}
        self.room_effect("focus")

    def check_focus(self) -> None:
        f = self.focus
        if f and time.time() >= f["until"]:
            self.focus = None
            self.room_effect("focus_end")
            self.add_fx("fireworks", f"{f['label']} · done")
            self.grow((f["until"] - f["start"]) / 60, f["label"])
            self.phone("focus", "Focus done · +1 building", f["label"], "building_construction", private_text=True)
            self.say(self.T("focus_done", label=f['label']), "focus")
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "Pulse", f"{f['label']}: done"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)

    # -- the city that grows with you: every focus you finish builds a building; a streak lights it, monuments come
    def growth(self) -> dict:
        try:
            g = json.loads((STATE_DIR / "city.json").read_text())
            if isinstance(g, dict) and isinstance(g.get("buildings"), list):
                return g
        except (OSError, ValueError):
            pass
        return {"buildings": [], "best": 0}

    def grow(self, minutes: float, label: str = "") -> None:
        if minutes < (0 if self.demo else float(self.conf("city", "min_minutes", default=10) or 0)) or self.conf("city", "enabled", default=True) is False:
            return
        g = self.growth()
        g["buildings"] = (g["buildings"] + [{"t": int(time.time()), "m": int(round(minutes)), "label": str(label)[:24]}])[-2000:]
        self.stat("focus")
        self.stat("focus_min", round(minutes))
        streak = growth_streak([b["t"] for b in g["buildings"]])
        new_monument = streak > g.get("best", 0) and streak % 7 == 0
        g["best"] = max(g.get("best", 0), streak)
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            (STATE_DIR / "city.json").write_text(json.dumps(g))
        except OSError as e:
            log(f"city: {e}")
            return
        self.add_fx("build", f"+1 building · {len(g['buildings'])} in your city", small=True)
        if new_monument:
            self.add_fx("fireworks", f"{streak} days in a row · a monument")
            self.say(self.T("monument", n=streak), "focus")

    def growth_state(self) -> dict:
        g = self.growth()
        bs = g["buildings"]
        days = growth_days([b["t"] for b in bs])
        today = time.strftime("%Y-%m-%d")
        yday = time.strftime("%Y-%m-%d", time.localtime(time.time() - 86400))
        return {"n": len(bs), "streak": growth_streak([b["t"] for b in bs]), "best": g.get("best", 0),
                "lit": today in days or yday in days, "today": sum(1 for b in bs if time.strftime("%Y-%m-%d", time.localtime(b["t"])) == today),
                "monuments": min(6, g.get("best", 0) // 7), "recent": [{"m": b["m"], "t": b["t"]} for b in bs[-48:]]}

    # -- the planes over you: adsb.lol (default, free), OpenSky, or your own receiver (dump1090 / readsb)
    def flight_route(self, flight: str) -> dict:
        """Where a flight comes from and goes (adsbdb.com), kept for a day; at most one new lookup every few seconds."""
        if not re.match(r"^[A-Z]{3}[0-9][0-9A-Z]{0,4}$", flight or ""):
            return {}
        cache = self.__dict__.setdefault("routes", {})
        hit = cache.get(flight)
        if hit and time.time() - hit[0] < 86400:
            return hit[1]
        if time.time() - self.__dict__.get("route_t", 0) < 3:
            return {}
        self.route_t = time.time()
        out: dict = {}
        try:
            fr = (http_json(f"https://api.adsbdb.com/v0/callsign/{flight}").get("response") or {}).get("flightroute") or {}
            o, d = fr.get("origin") or {}, fr.get("destination") or {}
            if o.get("iata_code") and d.get("iata_code"):
                out = {"from": str(o["iata_code"])[:4], "to": str(d["iata_code"])[:4],
                       "fromCity": str(o.get("municipality") or "")[:24], "toCity": str(d.get("municipality") or "")[:24],
                       "airline": str((fr.get("airline") or {}).get("name") or "")[:28]}
        except Exception:   # noqa: BLE001 - an unknown callsign is a 404: just no route
            pass
        if len(cache) > 500:
            cache.clear()
        cache[flight] = (time.time(), out)
        return out

    def loop_sky(self) -> None:
        warned, last = 0.0, 0.0
        while True:
            c = self.conf("sky", default={}) or {}
            src = str(c.get("source") or "adsb.lol")
            every = float(c.get("every") or (240 if src == "opensky" else 15))
            if c.get("enabled") is False or self.demo or not self.location:
                time.sleep(20)
                continue
            if time.time() - last < every:
                time.sleep(1)
                continue
            last = time.time()
            lat, lon = self.location
            nm = int(c.get("radius", 25) or 25)
            try:
                if src == "opensky":
                    d = nm / 60
                    j = http_json(f"https://opensky-network.org/api/states/all?lamin={lat - d:.3f}&lomin={lon - d * 1.4:.3f}"
                                  f"&lamax={lat + d:.3f}&lomax={lon + d * 1.4:.3f}")
                    raw = [{"hex": r[0], "flight": r[1], "lat": r[6], "lon": r[5], "alt": (r[7] or 0) * 3.281, "gs": (r[9] or 0) * 1.944,
                            "track": r[10], "ground": r[8]} for r in (j.get("states") or []) if len(r) > 10]
                else:
                    url = src if src.startswith("http") else f"https://api.adsb.lol/v2/lat/{lat:.4f}/lon/{lon:.4f}/dist/{nm}"
                    j = http_json(url)
                    raw = [{"hex": a.get("hex"), "flight": a.get("flight"), "lat": a.get("lat"), "lon": a.get("lon"),
                            "alt": a.get("alt_baro"), "gs": a.get("gs"), "track": a.get("track"), "type": a.get("t"),
                            "ground": a.get("alt_baro") == "ground"} for a in (j.get("ac") or j.get("aircraft") or [])]
                planes = planes_over(lat, lon, raw)
                if c.get("routes", True) is not False:
                    for pl in planes:
                        pl.update(self.flight_route(pl["flight"]))
                self.sky = {"planes": planes, "t": time.time()}
                for pl in planes:
                    self.stat("planes", unique=pl["id"] + time.strftime("%Y%m%d"))
            except Exception as e:   # noqa: BLE001
                if time.time() - warned > 3600:
                    warned = time.time()
                    log(f"sky: {e}")

    # -- your calendar: the next events are trains coming into the station; five minutes before, the voice tells you
    def loop_calendar(self) -> None:
        fetched, cache, warned = 0.0, [], 0.0
        while True:
            c = self.conf("calendar", default={}) or {}
            if not (c.get("ics") or c.get("command")) or c.get("enabled") is False:
                self.calendar = []
                time.sleep(30)
                continue
            now = time.time()
            try:
                if now - fetched > float(c.get("every", 300) or 300):
                    fetched = now
                    evs = []
                    for u in ([c["ics"]] if isinstance(c.get("ics"), str) else c.get("ics") or []):
                        u = str(u)
                        if u.startswith("http"):
                            req = urllib.request.Request(u.replace("webcal://", "https://"), headers={"User-Agent": "omarchy-pulse/" + VERSION})
                            with urllib.request.urlopen(req, timeout=20) as r:
                                text = r.read(5_000_000).decode("utf-8", "replace")
                        else:
                            text = Path(u).expanduser().read_text(errors="replace")
                        evs += ics_events(text, now - 3600, now + 86400)
                    if c.get("command"):
                        out = subprocess.run(["bash", "-c", str(c["command"])], capture_output=True, timeout=30, env=self.src_env()).stdout
                        evs += command_events(out.decode("utf-8", "replace"))
                    cache = sorted(evs, key=lambda e: e["start"])
                hours = float(c.get("hours", 3) or 3)
                nxt = [e for e in cache if e["end"] > now and e["start"] < now + hours * 3600][:6]
                warn = float(c.get("warn", 5) or 0) * 60
                for e in nxt:
                    key = f"{e['title']}|{e['start']}"
                    if warn and 0 < e["start"] - now <= warn and key not in self.cal_warned:
                        self.cal_warned.add(key)
                        mins = max(1, round((e["start"] - now) / 60))
                        self.add_fx("train", f"{e['title'][:30]} · in {mins} min")
                        self.say(self.T("meeting_in", title=e['title'], mins=mins), "calendar")
                        self.phone("calendar", f"In {mins} minutes", e["title"], "calendar", private_text=True)
                        self.note("calendar", f"{e['title']} at {time.strftime('%H:%M', time.localtime(e['start']))}", "info")
                self.calendar = nxt
                self.cal_all = cache
                was, self.in_meeting = self.in_meeting, any(e["start"] <= now < e["end"] for e in cache)
                if self.in_meeting != was:
                    log("meeting " + ("started: privacy on" if self.in_meeting else "ended: privacy off")
                        if c.get("privacy", True) is not False else "meeting " + ("started" if self.in_meeting else "ended"))
                # the evening summary, once a day
                at = re.match(r"^(\d{1,2}):(\d{2})$", str(c.get("summary_at", "18:00") or ""))
                day = time.strftime("%Y-%m-%d")
                if at and self.summary_day != day and time.localtime().tm_hour * 60 + time.localtime().tm_min >= int(at[1]) * 60 + int(at[2]):
                    self.summary_day = day
                    text = day_summary(cache, now)
                    n_today, secs_today = day_totals(cache, now)
                    if n_today:
                        self.stat("meetings", n_today)
                        self.stat("meeting_min", round(secs_today / 60))
                    if text:
                        self.add_fx("summary", text)
                        self.note("calendar", text, "info")
                        lang = voice_lang(self.conf("voice", default={}) or {})
                        n, secs = day_totals(cache, now)
                        self.say(phrase("summary" if n != 1 else "summary1", lang, n=n, dur=spoken_duration(secs / 60, lang)), "calendar")
                        if shutil.which("notify-send"):
                            subprocess.Popen(["notify-send", "Pulse · your day", text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"calendar: {e}")
            time.sleep(10)

    # -- your home (Home Assistant): the doorbell turns the sphere into the door camera; your lights, one click away
    def ha(self, path: str, body: dict | None = None):
        h = self.conf("home", default={}) or {}
        base = str(h.get("url") or "").rstrip("/")
        req = urllib.request.Request(base + path, data=json.dumps(body).encode() if body is not None else None,
                                     method="POST" if body is not None else "GET",
                                     headers={"Authorization": "Bearer " + str(h.get("token") or ""), "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=8) as r:
            data = r.read(3_000_000)
        return data if path.startswith("/api/camera_proxy/") else json.loads(data or b"null")

    def loop_home(self) -> None:
        last_bell, lights_t, warned = None, 0.0, 0.0
        while True:
            h = self.conf("home", default={}) or {}
            if not h.get("url") or not h.get("token") or h.get("enabled") is False or self.demo:
                time.sleep(20)
                continue
            now = time.time()
            try:
                bell = str(h.get("doorbell") or "")
                if bell:
                    st = self.ha("/api/states/" + urllib.parse.quote(bell))
                    mark = st.get("state") if bell.startswith("binary_sensor.") else st.get("last_changed")
                    rang = (mark == "on" and last_bell not in (None, "on")) if bell.startswith("binary_sensor.") else (last_bell is not None and mark != last_bell)
                    last_bell = mark
                    if rang:
                        self.doorbell()
                if self.ring and now - self.ring["t"] < 60 and h.get("camera"):
                    self.images["doorbell"] = (self.ha("/api/camera_proxy/" + urllib.parse.quote(str(h["camera"]))), "image/jpeg", now)
                    self.set_widget("doorbell", title="door", type="image", slot="right", order=1, private=True,
                                    data={"src": "/img/doorbell", "live": True})
                elif self.ring and now - self.ring["t"] >= 60:
                    self.ring = None
                    self.drop_widget("doorbell")
                if h.get("lights") and now - lights_t > 10:
                    lights_t = now
                    items = []
                    for ent in list(h["lights"])[:8]:
                        st = self.ha("/api/states/" + urllib.parse.quote(str(ent)))
                        items.append({"title": str((st.get("attributes") or {}).get("friendly_name") or ent)[:18],
                                      "level": "ok" if st.get("state") == "on" else "", "note": str(st.get("state", ""))[:6]})
                    self.home_lights = list(h["lights"])[:8]
                    self.set_widget("home", title="home", type="status", slot=str(h.get("panel", "right")), order=35,
                                    icon="󰋜", data={"items": items}, itemclick=True)
            except Exception as e:   # noqa: BLE001
                if now - warned > 600:
                    warned = now
                    log(f"home: {e}")
            time.sleep(max(1.0, float(h.get("every", 2) or 2)))

    def doorbell(self) -> None:
        self.ring = {"t": time.time()}
        self.stat("doorbell")
        self.room_effect("doorbell")
