    Only the event, the tool name and the project folder are used: never the prompt or the code."""
    if kind == "codex":
        data = json.loads(args[-1]) if args else {}
        if data.get("type") == "agent-turn-complete":
            cwd = Path(data.get("cwd") or os.getcwd()).name
            quiet_client("/api/agent/" + urllib.parse.quote(f"codex · {cwd}"[:32]) + "?state=done&text=turn+complete")
        return
    data = json.loads(sys.stdin.read() or "{}")
    ev = data.get("hook_event_name", "")
    name = f"claude · {Path(data.get('cwd') or os.getcwd()).name}"[:32]
    state, text = {
        "SessionStart": ("idle", "ready"),
        "UserPromptSubmit": ("working", "thinking"),
        "PreToolUse": ("working", TOOL_WORDS.get(data.get("tool_name", ""), str(data.get("tool_name", "working"))[:24])),
        "Notification": ("waiting", "needs you"),
        "Stop": ("done", "finished"),
        "SessionEnd": ("gone", ""),
    }.get(ev, (None, None))
    if state:
        quiet_client("/api/agent/" + urllib.parse.quote(name) + "?" + urllib.parse.urlencode({"state": state,
                                                                                               "text": text}))


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd in ("run", "serve"):
        demo = "--demo" in argv
        hub = Hub(demo=demo)
        port = port_of()
        try:
            serve(hub, port)
        except OSError as e:
            log(f"port {port} busy ({e}): is Pulse already running? (systemctl --user status omarchy-pulse)")
            return 1
        hub.start()
        url = f"http://127.0.0.1:{port}/?token={token()}"
        log(f"Omarchy Pulse {VERSION} on http://127.0.0.1:{port}/" + (" (demo data)" if demo else ""))
        if cmd == "serve":
            print(url, flush=True)
            try:
                while True:
                    time.sleep(3600)
            except KeyboardInterrupt:
                return 0
        return run_wall(url, str(hub.conf("pulse", "gpu", default="auto")), str(hub.conf("pulse", "dmabuf", default="auto")))
    if cmd == "push":
        if len(argv) < 4:
            print("usage: omarchy-pulse push NAME VALUE|- [--title T] [--type T] [--level L] [--slot S]")
            return 2
        name, value = argv[2], argv[3]
        opts = {}
        rest = argv[4:]
        for i, a in enumerate(rest):
            if a.startswith("--") and i + 1 < len(rest):
                opts[a[2:]] = rest[i + 1]
        if value == "-":
            body = sys.stdin.buffer.read()
        elif Path(value).is_file() and Path(value).suffix.lower() in (".jpg", ".jpeg", ".png", ".webp"):
            body = Path(value).read_bytes()
            opts.setdefault("_img", Path(value).suffix.lower().lstrip(".").replace("jpg", "jpeg"))
        else:
            body = value.encode()
        img = opts.pop("_img", None)
        qs = urllib.parse.urlencode(opts)
        try:
            client("POST", f"/api/push/{urllib.parse.quote(name)}?{qs}", body, f"image/{img}" if img else "text/plain")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "agent":
        if len(argv) < 4:
            print("usage: omarchy-pulse agent NAME working|waiting|done|failed|idle|gone [TEXT]")
            return 2
        q = urllib.parse.urlencode({"state": argv[3], "text": " ".join(argv[4:])})
        return quiet_client(f"/api/agent/{urllib.parse.quote(argv[2])}?{q}")
    if cmd == "banner":
        text = " ".join(argv[2:]) or str((load_config().get("pulse") or {}).get("banner") or "OMARCHY · WE CAN FIX EVERYTHING")
        return quiet_client("/api/fx?" + urllib.parse.urlencode({"kind": "banner", "text": text[:48]}))
    if cmd == "robot":
        if len(argv) < 4:
            print("usage: omarchy-pulse robot NAME ok|working|waiting|failed|gone")
            return 2
        return quiet_client(f"/api/robot/{urllib.parse.quote(argv[2])}?" + urllib.parse.urlencode({"state": argv[3]}))
    if cmd == "fireworks":
        return quiet_client("/api/fx?" + urllib.parse.urlencode({"kind": "fireworks", "text": " ".join(argv[2:])}))
    if cmd == "focus":
        v = argv[2] if len(argv) > 2 else "25"
        try:
            r = client("POST", "/api/focus?" + urllib.parse.urlencode({"label": " ".join(argv[3:])}), v.encode())
            f = r.get("focus")
            print("focus: off" if not f else f"focus until {time.strftime('%H:%M', time.localtime(f['until']))}")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "perf":
        probe = "--probe" in argv
        try:
            if probe:
                client("POST", "/api/perf?probe=16")
                print("Measuring for 16 seconds with no frame limit. Switch to an EMPTY workspace now (no window over the\n"
                      "wallpaper, on every monitor): Hyprland slows down what is covered, which would hide the real numbers.")
                for i in range(17, 0, -1):
                    print(f"\r  {i:2d} s ", end="", flush=True)
                    time.sleep(1)
                print("\r       ")
            r = client("GET", "/api/perf")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        if probe:
            got = (r.get("perf") or {}).get("_probe") or {}
            print(f"NVIDIA: {'yes' if r.get('nvidia') else 'no'} · WebKit DMA-BUF renderer: {'on' if r.get('dmabuf') else 'off'} · uncapped (asked 60)")
            if not got:
                print("no report: the wallpaper was covered or full screen the whole time; try again on an empty workspace")
            for p in got.values():
                print(f"  {p.get('name') or '?':10} {p['w']}x{p['h']} {p['scene']:8} {p['fps']:5.1f} fps  draw {p['draw']:.1f} ms  "
                      f"frame gap {p['gap']:.0f} ms (max {p['maxGap']:.0f})" + (f"  ({p['windows']} windows over it!)" if p.get("windows") else ""))
            return 0
        r["perf"] = {k: v for k, v in (r.get("perf") or {}).items() if k != "_probe"}
        print(f"NVIDIA: {'yes' if r.get('nvidia') else 'no'} · WebKit DMA-BUF renderer: {'on' if r.get('dmabuf') else 'off'}")
        if not r.get("perf"):
            print("no report yet: the pages report every 5 s while they draw (not while covered or full screen)")
        for p in r.get("perf", {}).values():
            print(f"  {p.get('name') or '?':10} {p['w']}x{p['h']} {p['scene']:8} {p['fps']:5.1f} fps (asked {p['want']:.0f}, "
                  f"cap {p['cap']:.0f})  draw {p['draw']:.1f} ms  frame gap {p['gap']:.0f} ms (max {p['maxGap']:.0f})"
                  + ("  <- slow to present" if p["bound"] else "") + (f"  · {p['windows']} windows" if p.get("windows") else ""))
        if any(p["cap"] < p["want"] or p["cap"] < 60 for p in r.get("perf", {}).values()):
            print("note: a lowered cap makes the gap look like the cap itself; `omarchy-pulse perf --probe` measures without it")
            if p["bound"]:
                print("     " + perf_hint(p, load_config().get("pulse", {}).get("dmabuf", "auto")).split(": ", 1)[1])
        return 0
    if cmd == "city":
        hub = Hub()
        g = hub.growth_state()
        print(f"Your city: {g['n']} buildings · streak {g['streak']} days · best {g['best']} · today {g['today']}"
              f" · {g['monuments']} monuments")
        print("every focus of 10 minutes or more you finish builds one: omarchy-pulse focus 25 \"write the guide\"")
        return 0
    if cmd == "car":
        acts = {"charge": "start_charging", "stop": "stop_charging", "lock": "lock", "unlock": "unlock",
                "climate": "start_climate", "climate-on": "start_climate", "climate-off": "stop_climate", "flash": "flash"}
        a = " ".join(argv[2:3] + (["off"] if argv[2:4] == ["climate", "off"] else []))
        a = "climate-off" if a == "climate off" else a
        try:
            if a:
                if a not in acts:
                    print("usage: omarchy-pulse car [charge | stop | lock | unlock | climate on | climate off | flash]")
                    return 2
                r = client("POST", "/api/car?do=" + acts[a])
                print("sent to the car" if r.get("ok") else "not allowed: is [car] enabled? (unlock also needs allow_unlock = true)")
                return 0 if r.get("ok") else 1
            v = client("GET", "/api/state").get("car")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        if not v:
            print("no car (set [car] in pulse.toml: Tessie or Home Assistant)")
            return 1
        print(f"car: {v['battery']:.0f}%" + (f" · {v['range']:.0f} {v['unit']}" if v.get("range") is not None else "")
              + f" · {v['state'].lower()}" + (f" · {v['power']:.0f} kW" if v.get("state") == "Charging" and v.get("power") else "")
              + (f" · limit {v['limit']:.0f}%" if v.get("limit") else ""))
        return 0
    if cmd == "doorbell":
        return quiet_client("/api/doorbell")
    if cmd == "notifications" and argv[2:3] == ["clear"]:
        return quiet_client("/api/click/notifications")
    if cmd == "calendar":
        r = client("GET", "/api/state")
        evs = r.get("calendar") or []
        if not evs:
            print("nothing in the next hours (or no [calendar] in pulse.toml)")
        for e in evs:
            print(time.strftime("%H:%M", time.localtime(e["start"])), "-", time.strftime("%H:%M", time.localtime(e["end"])), e["title"] or "(private)")
        return 0
    if cmd == "phone":
        sub = argv[2] if len(argv) > 2 else ""
        if sub == "new":
            topic = "pulse-" + secrets.token_urlsafe(12)
            print(f"Your phone topic: {topic}\n\n1. Install the ntfy app (iOS or Android) and subscribe to: {topic}\n"
                  f"2. Put this in ~/.config/omarchy-pulse/pulse.toml:\n\n[phone]\nenabled = true\ntopic = \"{topic}\"\n\n"
                  "3. omarchy-pulse phone test\n\nKeep the topic to yourself: anyone who knows it can read these messages.")
            return 0
        if sub == "test":
            c = load_config().get("phone") or {}
            if not c.get("topic"):
                print("no [phone] topic yet: omarchy-pulse phone new")
                return 1
            server = str(c.get("server") or "https://ntfy.sh").rstrip("/")
            urllib.request.urlopen(urllib.request.Request(f"{server}/{c['topic']}", data="Hello from your city".encode(), method="POST",
                                                          headers={"Title": "Omarchy Pulse", "Tags": "city_sunset"}), timeout=10).read()
            print("sent: look at your phone")
            return 0
        print("usage: omarchy-pulse phone new | test")
        return 2
    if cmd == "lights":
        sub = argv[2] if len(argv) > 2 else ""
        if sub == "pair":   # Philips Hue: press the bridge's button, then run this within 30 seconds
            ip = argv[3] if len(argv) > 3 else ""
            if not ip:
                try:
                    found = http_json("https://discovery.meethue.com/")
                    ip = found[0]["internalipaddress"] if found else ""
                except Exception:   # noqa: BLE001
                    ip = ""
            if not ip:
                print("bridge not found: omarchy-pulse lights pair 192.168.x.y")
                return 1
            req = urllib.request.Request(f"http://{ip}/api", data=json.dumps({"devicetype": "omarchy_pulse#pc"}).encode(), method="POST")
            with urllib.request.urlopen(req, timeout=8) as rr:
                res = json.loads(rr.read())
            user = next((x["success"]["username"] for x in res if "success" in x), None)
            if not user:
                print("press the round button on the Hue bridge, then run this again within 30 seconds")
                return 1
            req = urllib.request.Request(f"http://{ip}/api/{user}/lights")
            with urllib.request.urlopen(req, timeout=8) as rr:
                ls = json.loads(rr.read())
            print(f"paired. Put this in [lights] of pulse.toml:\n\nenabled = true\nsource = \"hue\"\nbridge = \"{ip}\"\nuser = \"{user}\"\n"
                  f"lights = [{', '.join(repr(str(k)).replace(chr(39), chr(34)) for k in ls)}]   # " + ", ".join(f"{k} {v.get('name')}" for k, v in ls.items()))
            return 0
        if sub in ("test", "alert", "doorbell", "lightning", "quake"):
            return quiet_client("/api/lights?effect=" + ("doorbell" if sub == "test" else sub))
        print("usage: omarchy-pulse lights pair [BRIDGE_IP] | test | alert | lightning | quake")
        return 2
    if cmd == "wrapped":
        year = argv[2] if len(argv) > 2 else time.strftime("%Y")
        out = make_wrapped(year, load_config().get("timelapse") or {})
        print(out if out else "no ffmpeg, or nothing yet for " + year)
        return 0 if out else 1
    if cmd == "sky":
        try:
            r = client("GET", "/api/state")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        n, sl = r.get("night") or {}, (r.get("starlink") or {}).get("next")
        if n:
            m = n["moon"]
            print(f"Moon: {m['name']}, {round(m['lit'] * 100)}% lit, " + (f"{m['el']:.0f}° up, {compass(m['az'])}" if m["el"] > 0 else "below the horizon"))
            for p in n.get("planets") or []:
                if p["el"] > 0:
                    print(f"{p['n'].capitalize()}: {p['el']:.0f}° up, {compass(p['az'])}")
            if n.get("shower"):
                print(f"Meteor shower: {n['shower']['name']} ({round(n['shower']['strength'] * 100)}% of its peak)")
        print(("Next Starlink train: " + time.strftime("%H:%M", time.localtime(sl["start"])) + f", {sl['max_el']}° up, {compass(sl['az'])}, {sl['n']} satellites")
              if sl else "No Starlink train over you in the next 24 hours.")
        a = r.get("air")
        if a and a.get("aqi") is not None:
            print(f"Air: {a['level']} (AQI {a['aqi']})" + (f", {a['pollen']} pollen {a['pollenLevel']}" if a.get("pollen") else ""))
        return 0
    if cmd == "timelapse":
        day = argv[2] if len(argv) > 2 and argv[2] != "today" else time.strftime("%Y-%m-%d")
        out = make_timelapse(day, load_config().get("timelapse") or {}, keep=day == time.strftime("%Y-%m-%d"))
        print(out if out else f"no pictures for {day} yet (the wallpaper takes one every few minutes while you see it), or no ffmpeg")
        return 0 if out else 1
    if cmd == "listen":
        a = argv[2] if len(argv) > 2 else "5"
        if a == "--file" and len(argv) > 3:
            return quiet_client("/api/listen?" + urllib.parse.urlencode({"file": str(Path(argv[3]).resolve())}), b"2")
        return quiet_client("/api/listen", a.encode())
    if cmd == "crew":
        if len(argv) > 2 and argv[2] == "new":
            code = secrets.token_urlsafe(18)
            print(f"Your crew code: {code}\n\nPut it in ~/.config/omarchy-pulse/pulse.toml on every PC of the crew:\n\n"
                  f"[crew]\ncode = \"{code}\"\nname = \"{os.environ.get('USER', 'me')}\"\n\n"
                  "Share it only with the people you want in your city. Messages go through the relay (ntfy.sh by\n"
                  "default) sealed with this code: the relay sees only noise.")
            return 0
        cfg = load_config().get("crew") or {}
        print("crew: " + ("off (omarchy-pulse crew new)" if not cfg.get("code") else
                          f"on as {cfg.get('name') or os.environ.get('USER', 'friend')}, relay {cfg.get('relay') or 'https://ntfy.sh'}"))
        return 0
    if cmd in ("away", "back"):
        return quiet_client("/api/presence", cmd.encode())
    if cmd == "say":
        return quiet_client("/api/say", " ".join(argv[2:]).encode())
    if cmd == "watch":
        if "--" not in argv or argv.index("--") < 3 or argv.index("--") == len(argv) - 1:
            print("usage: omarchy-pulse watch NAME -- COMMAND [ARGS...]")
            return 2
        name, job = argv[2], argv[argv.index("--") + 1:]
        quiet_client(f"/api/agent/{urllib.parse.quote(name)}?" + urllib.parse.urlencode(
            {"state": "working", "text": " ".join(job)[:60]}))
        try:
            rc = subprocess.call(job)
        except FileNotFoundError:
            rc = 127
        except KeyboardInterrupt:
            rc = 130
        quiet_client(f"/api/agent/{urllib.parse.quote(name)}?" + urllib.parse.urlencode(
            {"state": "done" if rc == 0 else "failed", "text": "ok" if rc == 0 else f"exit {rc}"}))
        return rc
    if cmd == "hook":
        try:
            agent_hook(argv[2] if len(argv) > 2 else "claude", argv[3:])
        except Exception:   # noqa: BLE001 - a hook must never get in the agent's way
            pass
        return 0
    if cmd == "privacy":
        v = argv[2] if len(argv) > 2 else "toggle"
        try:
            print("privacy:", "on" if client("POST", "/api/privacy", v.encode())["privacy"] else "off")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "scene":
        cur = str((load_config().get("pulse") or {}).get("scene", "sphere"))
        if len(argv) < 3:
            print(f"scene: {cur}   (choose one: {' | '.join(SCENES)}, or next)")
            return 0
        name = argv[2].lower()
        if name == "next":
            name = SCENES[(SCENES.index(cur) + 1) % len(SCENES)] if cur in SCENES else SCENES[0]
        if name not in SCENES:
            print(f"unknown scene {name!r}: {' | '.join(SCENES)}", file=sys.stderr)
            return 1
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        text = CONF.read_text() if CONF.exists() else (HERE / "pulse.toml").read_text()
        CONF.write_text(with_scene(text, name))
        quiet_client("/api/reload")   # running: now; otherwise the next start shows it
        print(f"scene: {name}")
        return 0
    if cmd == "reload":
        try:
            client("POST", "/api/reload")
            print("reloaded")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "doctor":
        ok = True
        print(f"Omarchy Pulse {VERSION}")
        for mod, pkg in (("Gtk 3.0", "gtk3"), ("GtkLayerShell 0.1", "gtk-layer-shell"), ("WebKit2 4.1", "webkit2gtk-4.1")):
            r = subprocess.run([sys.executable, "-c", f"import gi; gi.require_version('{mod.split()[0]}', '{mod.split()[1]}');"
                                f"from gi.repository import {mod.split()[0]}"], capture_output=True)
            print(("  ok   " if r.returncode == 0 else "  MISS ") + f"{mod:20} ({pkg})")
            ok &= r.returncode == 0
        for tool, why in (("ffmpeg", "cameras"), ("playerctl", "now playing"), ("cava", "the scene dances with music"),
                          ("gh", "GitHub notifications"), ("fping", "finds every device on your network"),
                          ("piper-tts", "the voice (or espeak-ng)"), ("espeak-ng", "a simpler voice"),
                          ("whisper-cli", "hey sphere: speech to text (or faster-whisper)"), ("git", "the Git city"),
                          ("hyprctl", "calm down under windows, privacy")):
            print(("  ok   " if shutil.which(tool) else "  --   ") + f"{tool:20} ({why})")
        notification_dir = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy/notifications"
        notification_backend = "Omarchy" if any((notification_dir / n).is_file() for n in ("live.json", "history.json")) else "makoctl" if shutil.which("makoctl") else "none detected"
        print(f"  {'--' if notification_backend == 'none detected' else 'ok'}   notifications        ({notification_backend})")
        cfg = load_config()
        if cfg.get("_error"):
            print("  ERR  pulse.toml: " + cfg["_error"])
            ok = False
        else:
            print(f"  ok   {CONF} ({len(cfg.get('source', []))} sources)")
        print(f"  theme: {theme_name() or '?'}")
        if (STATE_DIR / "dmabuf-crash").exists():
            print(f"  DMA-BUF renderer: turned off after crashes on start (delete {STATE_DIR / 'dmabuf-crash'} to try again)")
        if nvidia():
            off = dmabuf_disabled((cfg.get("pulse") or {}).get("dmabuf", "auto"), True)
            print(f"  NVIDIA: WebKit DMA-BUF renderer {'off (safe; frames are copied through the CPU)' if off else 'on'}"
                  + ('; if the wallpaper is choppy or heavy, try dmabuf = "on" in [pulse]' if off else ""))
        return 0 if ok else 1
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
