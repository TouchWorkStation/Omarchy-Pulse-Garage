def containers(out: str) -> list:
    """`docker ps` / `podman ps` (one JSON per line, or a JSON list) -> name and health of each running container."""
    rows = []
    out = (out or "").strip()
    if out.startswith("["):
        try:
            rows = json.loads(out)
        except ValueError:
            rows = []
    else:
        for line in out.splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    res = []
    for x in rows[:24]:
        if not isinstance(x, dict):
            continue
        names = x.get("Names")
        name = names[0] if isinstance(names, list) and names else str(names or x.get("Name") or x.get("ID") or "")[:24]
        st = str(x.get("Status") or x.get("State") or "").lower()
        health = "bad" if "unhealthy" in st else "restart" if "restarting" in st else "ok"
        if "exited" in st or "created" in st:
            continue
        key = __import__("hashlib").sha1(str(x.get("ID") or x.get("Id") or name).encode()).hexdigest()[:8]
        res.append({"id": key, "name": str(name).lstrip("/")[:20], "health": health})
    return res


def rgb_to_xy(rgb) -> list:
    """An RGB colour as Philips Hue's CIE xy."""
    def lin(c):
        c = c / 255
        return ((c + 0.055) / 1.055) ** 2.4 if c > 0.04045 else c / 12.92
    r_, g_, b_ = (lin(float(v)) for v in rgb)
    X, Y, Z = r_ * 0.4124 + g_ * 0.3576 + b_ * 0.1805, r_ * 0.2126 + g_ * 0.7152 + b_ * 0.0722, r_ * 0.0193 + g_ * 0.1192 + b_ * 0.9505
    s_ = X + Y + Z
    return [round(X / s_, 4), round(Y / s_, 4)] if s_ else [0.3127, 0.329]


def compass(az: float) -> str:
    return ("north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west")[int(((az % 360) + 22.5) // 45) % 8]


def ring_point(lat: float, lon: float, bearing: float, km: float) -> tuple:
    """The point km away from (lat, lon) towards bearing."""
    import math
    R, b, la, lo = 6371.0, math.radians(bearing), math.radians(lat), math.radians(lon)
    d = km / R
    la2 = math.asin(math.sin(la) * math.cos(d) + math.cos(la) * math.sin(d) * math.cos(b))
    lo2 = lo + math.atan2(math.sin(b) * math.sin(d) * math.cos(la), math.cos(d) - math.sin(la) * math.sin(la2))
    return math.degrees(la2), (math.degrees(lo2) + 540) % 360 - 180


POLLEN = ("alder", "birch", "grass", "mugwort", "olive", "ragweed")


def air_view(cur: dict) -> dict:
    """European AQI and its level, fine dust, and the strongest pollen right now (grains per m³)."""
    aqi = cur.get("european_aqi")
    aqi = float(aqi) if isinstance(aqi, (int, float)) else None
    level = (None if aqi is None else "good" if aqi < 20 else "fair" if aqi < 40 else "moderate" if aqi < 60 else
             "poor" if aqi < 80 else "very poor" if aqi < 100 else "extremely poor")
    pol = [(k, float(cur.get(k + "_pollen") or 0)) for k in POLLEN if isinstance(cur.get(k + "_pollen"), (int, float))]
    top = max(pol, key=lambda x: x[1]) if pol else None
    plevel = None if not top or top[1] < 1 else "low" if top[1] < 20 else "moderate" if top[1] < 50 else "high" if top[1] < 200 else "very high"
    return {"aqi": None if aqi is None else round(aqi), "level": level, "pm25": cur.get("pm2_5"),
            "pollen": top[0] if plevel else None, "pollenLevel": plevel, "pollenValue": round(top[1], 1) if top else 0}


def parse_launch(r: dict) -> dict | None:
    import datetime as dt
    try:
        net = dt.datetime.fromisoformat(str(r["net"]).replace("Z", "+00:00")).timestamp()
    except (KeyError, ValueError):
        return None
    name = str(r.get("name") or "")
    rocket, _, mission = name.partition("|")
    rocket = re.sub(r"\s+Block\s+\d+", "", rocket).strip()[:24] or "rocket"
    return {"id": str(r.get("id") or name), "rocket": rocket, "mission": mission.strip()[:32] or name[:32], "net": net,
            "status": str((r.get("status") or {}).get("abbrev") or "TBD")[:10]}


def countdown(secs: float) -> str:
    if secs < 0:
        return "liftoff"
    d, r = divmod(int(secs), 86400)
    h, r = divmod(r, 3600)
    m = r // 60
    return "T-" + (f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m {int(secs) % 60:02d}s")


def heart_value(raw: str, path: str = "") -> int | None:
    v = raw
    try:
        j = json.loads(raw)
        v = dig(j, path) if path else j
        if isinstance(v, dict):
            v = v.get("state", v.get("value", v.get("bpm")))
    except (ValueError, KeyError, IndexError, TypeError):
        pass
    m = re.search(r"\d+(?:[.,]\d+)?", str(v))
    if not m:
        return None
    bpm = float(m.group().replace(",", "."))
    return round(bpm) if 30 <= bpm <= 230 else None


def crew_keys(code: str) -> tuple:
    k = hashlib.sha256(b"omarchy-pulse crew key|" + code.encode()).digest()
    m = hashlib.sha256(b"omarchy-pulse crew mac|" + code.encode()).digest()
    return k, m


def crew_topic(code: str) -> str:
    return "pulse-" + hashlib.sha256(b"omarchy-pulse crew topic|" + code.encode()).hexdigest()[:32]


def _keystream(key: bytes, nonce: bytes, n: int) -> bytes:
    out, i = b"", 0
    while len(out) < n:
        out += hmac.new(key, nonce + i.to_bytes(4, "big"), hashlib.sha256).digest()
        i += 1
    return out[:n]


def crew_seal(code: str, obj: dict) -> str:
    """Encrypt-then-MAC with HMAC-SHA256 (a keystream from HMAC in counter mode, then a tag): stdlib only."""
    k, m = crew_keys(code)
    pt = json.dumps(obj, separators=(",", ":")).encode()
    nonce = secrets.token_bytes(16)
    ct = bytes(a ^ b for a, b in zip(pt, _keystream(k, nonce, len(pt))))
    tag = hmac.new(m, nonce + ct, hashlib.sha256).digest()
    return base64.urlsafe_b64encode(nonce + ct + tag).decode()


def crew_open(code: str, msg: str) -> dict:
    k, m = crew_keys(code)
    raw = base64.urlsafe_b64decode(str(msg).encode())
    if len(raw) < 49:
        raise ValueError("short")
    nonce, ct, tag = raw[:16], raw[16:-32], raw[-32:]
    if not hmac.compare_digest(tag, hmac.new(m, nonce + ct, hashlib.sha256).digest()):
        raise ValueError("bad tag")
    return json.loads(bytes(a ^ b for a, b in zip(ct, _keystream(k, nonce, len(ct)))))


_WHISPER = {}


def speech_to_text(wav: str, conf: dict) -> str | None:
    """A command of yours (with {wav}), whisper.cpp, or faster-whisper; None when there is no engine."""
    lang = str(conf.get("language") or "auto")
    if conf.get("command"):
        r = subprocess.run(["bash", "-c", str(conf["command"]).replace("{wav}", shlex_quote(wav))], capture_output=True,
                           timeout=120)
        return r.stdout.decode("utf-8", "replace").strip()
    exe = shutil.which("whisper-cli") or shutil.which("whisper-cpp")
    model = str(conf.get("model") or "")
    if exe:
        if not model:
            d = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "whisper"
            found = sorted(d.glob("ggml-*.bin")) if d.is_dir() else []
            model = str(found[0]) if found else ""
        if model:
            r = subprocess.run([exe, "-m", str(Path(model).expanduser()), "-f", wav, "-nt", "-np", "-l", lang],
                               capture_output=True, timeout=120)
            return re.sub(r"\[[^\]]*\]", "", r.stdout.decode("utf-8", "replace")).strip()
    try:
        from faster_whisper import WhisperModel   # pip/pipx: faster-whisper
    except ImportError:
        return None
    name = model or "base"
    if name not in _WHISPER:
        _WHISPER[name] = WhisperModel(name, device="cpu", compute_type="int8")
    segs, _ = _WHISPER[name].transcribe(wav_samples(wav), language=None if lang == "auto" else lang, beam_size=1)
    return " ".join(x.text for x in segs).strip()


def wav_samples(wav: str):
    """A 16-bit PCM wav as 16 kHz mono float samples (what Whisper wants), without ffmpeg or PyAV."""
    import wave
    import numpy as np
    with wave.open(wav) as w:
        rate, ch, width = w.getframerate(), w.getnchannels(), w.getsampwidth()
        raw = w.readframes(w.getnframes())
    if width != 2:
        raise ValueError("16-bit wav expected")
    a = np.frombuffer(raw, np.int16).astype(np.float32) / 32768.0
    if ch > 1:
        a = a.reshape(-1, ch).mean(axis=1)
    if rate != 16000:
        a = np.interp(np.arange(0, len(a), rate / 16000), np.arange(len(a)), a).astype(np.float32)
    return a


def shlex_quote(s: str) -> str:
    import shlex
    return shlex.quote(s)


def nvidia() -> bool:
    return Path("/proc/driver/nvidia/version").exists()


def dmabuf_disabled(setting: str, on_nvidia: bool) -> bool:
    """WebKit's DMA-BUF renderer: "auto" turns it off on NVIDIA (some drivers draw nothing with it), "on" keeps it
    (much faster on recent NVIDIA drivers: no frame copy through the CPU), "off" always turns it off."""
    s = str(setting or "auto").lower()
    return s in ("off", "false", "no") or (s not in ("on", "true", "yes") and on_nvidia)


def perf_hint(p: dict, dmabuf: str) -> str:
    where = f"monitor {p.get('name') or '?'} ({p.get('w')}x{p.get('h')})"
    msg = (f"{where}: a frame takes {p['gap']:.0f} ms to reach the screen but only {p['draw']:.1f} ms to draw; "
           f"the time goes into copying and presenting it, so Pulse lowered this monitor to {p['cap']:.0f} fps")
    if nvidia() and dmabuf_disabled(dmabuf, True):
        msg += '; on NVIDIA try dmabuf = "on" in [pulse] (docs/GUIDE.md section 12)'
    return msg


def hypr_socket() -> str | None:
    env = hypr_env()
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    p = Path(rt) / "hypr" / sig / ".socket2.sock"
    return str(p) if p.exists() else None


# ---------------------------------------------------------------- HTTP (127.0.0.1 only)

def make_handler(hub: Hub, tok: str, port: int):
    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    types = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
             ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".ttf": "font/ttf", ".png": "image/png"}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code: int, body: bytes, ctype: str = "application/json", cache: bool = False) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "max-age=3600" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def _ok(self) -> bool:
            if self.headers.get("Host") not in hosts:   # DNS rebinding: only our own address
                self._send(403, b'{"error":"host"}')
                return False
            return True

        def _authed(self, q: dict) -> bool:
            got = self.headers.get("X-Pulse-Token") or q.get("token", "")
            if not secrets.compare_digest(str(got), tok):
                self._send(401, b'{"error":"token"}')
                return False
            return True

        def do_GET(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            path = u.path
            if path == "/api/visibility":
                if self._authed(q):
                    with hub.lock:
                        data = {"mons": hub.mons,
                                "pause_when_covered": hub.conf("pulse", "pause_when_covered", default=True)}
                        body = json.dumps(data, separators=(",", ":")).encode()
                    self._send(200, body)
                return
            if path == "/api/live":   # music bars and effects, as they happen (server-sent events)
                if not self._authed(q):
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                last_fx = hub.fx_seq if q.get("fx", "-1") == "-1" else int(q.get("fx", "0") or 0)
                sent, cur = 0.0, None
                with hub.lock:
                    hub.live_clients += 1
                try:
                    while True:
                        now = time.time()
                        audio = hub.audio if now - hub.audio_t < 0.5 else None
                        with hub.lock:
                            fx = [f for f in hub.fx if f["seq"] > last_fx]
                        if fx:
                            last_fx = fx[-1]["seq"]
                        c = hub.cursor if hub.cursor != cur else None
                        if audio is not None or fx or c or now - sent > 2:
                            msg = {"a": audio, "fx": fx}
                            if c:
                                msg["c"] = cur = c
                            self.wfile.write(b"data: " + json.dumps(msg, separators=(",", ":")).encode() + b"\n\n")
                            self.wfile.flush()
                            sent = now
                        time.sleep(0.05 if audio is not None else 0.2)
                except OSError:
                    return
                finally:
                    with hub.lock:
                        hub.live_clients -= 1
            if path in ("/api/garage/plate", "/api/garage/anchors"):
                if self._authed(q):
                    p = garage_plate(hub.conf("garage", default={}) or {})
                    if path.endswith("anchors"):
                        self._send(200, json.dumps(plate_anchors(p)).encode())
                    elif p:
                        self._send(200, p.read_bytes(), PLATE_TYPES[p.suffix.lower()])
                    else:
                        self._send(404, b"{}")
                return
            if path == "/api/perf":
                if self._authed(q):
                    with hub.lock:
                        self._send(200, json.dumps({"perf": hub.perf, "nvidia": nvidia(),
                                                    "dmabuf": not dmabuf_disabled(hub.conf("pulse", "dmabuf", default="auto"), nvidia())}).encode())
                return
            if path == "/api/state":
                if self._authed(q):
                    self._send(200, json.dumps(hub.state(), separators=(",", ":")).encode())
                return
            if path.startswith("/img/"):
                if not self._authed(q):
                    return
                if hub.privacy():
                    self._send(204, b"")
                    return
                img = hub.images.get(urllib.parse.unquote(path[5:]))
                if not img:
                    self._send(404, b"{}")
                    return
                self._send(200, img[0], img[1])
                return
            name = "index.html" if path in ("/", "") else path.lstrip("/")
            f = (WEB / name).resolve()
            if WEB.resolve() not in f.parents or not f.is_file():
                self._send(404, b"{}")
                return
            self._send(200, f.read_bytes(), types.get(f.suffix, "application/octet-stream"), cache=f.suffix == ".ttf")

        def do_POST(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            if not self._authed(q):
                return
            n = int(self.headers.get("Content-Length") or 0)
            if n < 0 or n > 8_000_000:
                self._send(413, b"{}")
                return
            body = self.rfile.read(n)
            if u.path.startswith("/api/push/"):
                q["_ctype"] = self.headers.get("Content-Type", "")
                hub.push(urllib.parse.unquote(u.path[10:]), body, q)
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/privacy":
                v = body.decode().strip()
                hub.privacy_manual = {"on": True, "off": False, "auto": None}.get(v, not hub.privacy())
                self._send(200, json.dumps({"privacy": hub.privacy()}).encode())
            elif u.path == "/api/reload":
                hub.reload(force=True)
                self._send(200, b'{"ok":true}')
            elif u.path.startswith("/api/robot/"):
                hub.set_bot(urllib.parse.unquote(u.path[len("/api/robot/"):]), q.get("state", "ok"))
                self._send(200, b'{"ok":true}')
            elif u.path.startswith("/api/agent/"):
                hub.set_agent(urllib.parse.unquote(u.path[11:]), q.get("state", "working"),
                              q.get("text") or body.decode("utf-8", "replace").strip())
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/fx":
                kind = re.sub(r"[^a-z]", "", q.get("kind", "fireworks"))[:20] or "fireworks"
                text = q.get("text") or body.decode("utf-8", "replace").strip()
                hub.add_fx(kind, text, **{k: float(q[k]) for k in ("mag", "az", "near", "tsunami") if re.match(r"^-?\d+(\.\d+)?$", q.get(k, ""))})
                if kind == "fireworks":
                    hub.crew_send({"ev": "fx", "text": text[:40]})
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/focus":
                v = body.decode().strip() or q.get("minutes", "")
                try:
                    mins = 0.0 if v in ("off", "stop", "0", "") else float(v)
                except ValueError:
                    mins = 0.0
                hub.set_focus(mins, q.get("label", ""))
                self._send(200, json.dumps({"focus": hub.focus}).encode())
            elif u.path == "/api/perf":
                if q.get("probe"):
                    secs = max(5.0, min(60.0, float(re.sub(r"[^0-9.]", "", q["probe"]) or 16)))
                    with hub.lock:
                        hub.perf.pop("_probe", None)
                        hub.perf_probe = time.time() + secs
                    self._send(200, b'{"ok":true}')
                    return
                try:
                    hub.set_perf(json.loads(body or b"{}"))
                except ValueError:
                    pass
                self._send(200, b"{}")
            elif u.path == "/api/listen":
                v = (body.decode().strip() or q.get("do", "start")).lower()
                if v == "clear":
                    hub.listen = None
                    ok = True
                elif v == "stop":
                    hub.listen_stop.set()
                    ok = True
                else:
                    secs = float(v) if re.match(r"^\d+(\.\d+)?$", v) else 10.0 if v == "start" else 5.0
                    wav = q.get("file", "")
                    ok = hub.listen_start(secs, wav if wav and Path(wav).is_file() else "")
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path == "/api/presence":
                v = body.decode().strip() or q.get("state", "")
                hub.set_away(v in ("away", "on", "idle"), "you")
                self._send(200, json.dumps({"away": bool(hub.away)}).encode())
            elif u.path == "/api/say":
                hub.say(q.get("text") or body.decode("utf-8", "replace").strip(), force=True)
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/timelapse":
                raw = body.split(b",", 1)[1] if body.startswith(b"data:") else body
                try:
                    ok = hub.timelapse_frame(q.get("mon", "0,0"), base64.b64decode(raw))
                except (ValueError, OSError):
                    ok = False
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path == "/api/doorbell":
                hub.doorbell()
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/lights":
                eff = q.get("effect", "")
                ok = eff in ("alert", "doorbell", "lightning", "quake") and bool(hub.room_lights())
                if ok:
                    hub.room_effect(eff)
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path == "/api/car":
                do = re.sub(r"[^a-z_]", "", q.get("do", ""))[:20]
                ok = hub.car_allowed(do)
                if ok:   # a car can take half a minute to answer: the command runs on its own
                    threading.Thread(target=hub.car_run, args=(do,), daemon=True).start()
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path.startswith("/api/click/") and q.get("item", "").isdigit():
                ok = hub.click(urllib.parse.unquote(u.path[len("/api/click/"):]), int(q["item"]))
                self._send(200 if ok else 404, json.dumps({"ok": ok}).encode())
            elif u.path.startswith("/api/click/"):
                ok = hub.click(urllib.parse.unquote(u.path[11:]))
                self._send(200 if ok else 404, b'{"ok":true}' if ok else b"{}")
            else:
                self._send(404, b"{}")
    return H


def serve(hub: Hub, port: int) -> ThreadingHTTPServer:
    srv = ThreadingHTTPServer(("127.0.0.1", port), make_handler(hub, token(), port))
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


# ---------------------------------------------------------------- the wallpaper window (GTK3 + layer shell + WebKit)

def dmabuf_guard(want_on: bool, state: Path) -> bool:
    """With the DMA-BUF renderer on, Pulse can die at once on some drivers (Wayland "Error 71"). Two starts in a row
    that do not live 30 seconds turn it off for good, until ~/.local/state/omarchy-pulse/dmabuf-crash is deleted."""
    guard, trial = state / "dmabuf-crash", state / "dmabuf-trial"
    if not want_on:
        return False
    if guard.exists():
        log("DMA-BUF renderer off: it made Pulse crash on start before (delete " + str(guard) + " to try it again)")
        return False
    try:
        n = int(trial.read_text().strip() or 0)
    except (OSError, ValueError):
        n = 0
    state.mkdir(parents=True, exist_ok=True)
    if n >= 2:
        guard.write_text(time.strftime("%Y-%m-%d %H:%M") + " WebKit's DMA-BUF renderer crashed Pulse twice on start\n")
        trial.unlink(missing_ok=True)
        log("DMA-BUF renderer off: Pulse crashed twice right after starting with it (dmabuf = \"on\" is ignored until "
            + str(guard) + " is deleted)")
        return False
    trial.write_text(str(n + 1))   # cleared after 30 seconds alive, or on a normal exit
    return True


