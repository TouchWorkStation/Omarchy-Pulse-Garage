def day_totals(events: list, now: float | None = None) -> tuple:
    """How many events today, and how many seconds they take (overlapping time counted once)."""
    now = now if now is not None else time.time()
    lt = time.localtime(now)
    d0 = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
    today = sorted((max(e["start"], d0), min(e["end"], d0 + 86400)) for e in events if e["start"] < d0 + 86400 and e["end"] > d0)
    if not today:
        return 0, 0.0
    total, cur = 0.0, None
    for a, b in today:
        if cur and a <= cur[1]:
            cur[1] = max(cur[1], b)
        else:
            if cur:
                total += cur[1] - cur[0]
            cur = [a, b]
    total += cur[1] - cur[0]
    return len(today), total


def day_summary(events: list, now: float | None = None) -> str:
    """today: 4 meetings · 3 h 20 min (the events of today, overlapping time counted once)."""
    n, total = day_totals(events, now)
    if not n:
        return ""
    h, m = divmod(int(round(total / 60)), 60)
    return f"today: {n} meeting{'s' * (n != 1)} · " + (f"{h} h {m} min" if h else f"{m} min")


